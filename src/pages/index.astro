---
import Base from '../layouts/Base.astro';
import Rocket from '../components/Rocket.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import HeroAtmosphere from '../components/HeroAtmosphere.astro';
import { getCollection } from 'astro:content';
import { url } from '../config';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).filter(
  (p) => p.data.featured
);
---

<Base ogImagePath="og/home.png" ogImageAlt="Vansh’s Technical Blog">
  <section class="hero shell">
    <HeroAtmosphere />
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> ENGINEERING / EXPLORATION / IDEAS</div>
      <h1>
        Engineering,<br />
        Aerospace,<br />
        <span class="accent-word">Software</span>
      </h1>
      <p class="hero-description">
        I’m Vansh, a mechanical engineering student focused on aerospace. This is where I explore aircraft, rockets, and the technology behind them.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={url('projects/')}>Explore projects <ArrowIcon /></a>
        <a class="text-link" href={url('writing/')}>Read the writing <ArrowIcon /></a>
      </div>
      <div class="hero-footnote">
        <Rocket /><span>ENGINEERING · AEROSPACE · SOFTWARE</span>
      </div>
    </div>

    <div class="hero-diagram">
      <div class="diagram-top">
        <span>FIG. 001</span><span>FLIGHT PATH / CONCEPT</span>
      </div>
      <svg viewBox="0 0 470 450" fill="none" aria-hidden="true">
        <defs>
          <pattern id="hero-grid" width="34" height="34" patternUnits="userSpaceOnUse">
            <path d="M34 0H0V34" stroke="currentColor" stroke-opacity=".07" />
          </pattern>
          <linearGradient id="trail" x1="100" y1="360" x2="330" y2="100" gradientUnits="userSpaceOnUse">
            <stop stop-color="#ff572e" stop-opacity="0" />
            <stop offset="1" stop-color="#ff572e" />
          </linearGradient>
        </defs>
        <rect width="470" height="450" fill="url(#hero-grid)" />
        <circle cx="235" cy="225" r="151" stroke="currentColor" stroke-opacity=".12" />
        <circle cx="235" cy="225" r="105" stroke="currentColor" stroke-opacity=".08" />
        <path d="M235 30v390M30 225h410" stroke="currentColor" stroke-opacity=".12" stroke-dasharray="3 7" />
        <path d="M55 390Q224 386 335 103" stroke="url(#trail)" stroke-width="2" />
        <path d="M85 400Q290 372 400 45" stroke="currentColor" stroke-opacity=".18" stroke-dasharray="5 7" />
        <g transform="translate(335 103) rotate(27)">
          <path d="M0-34C-14-18-15 8-9 24H9C15 8 14-18 0-34Z" stroke="currentColor" stroke-width="1.5" fill="var(--background)" />
          <circle cy="-3" r="5" stroke="var(--accent)" stroke-width="1.5" />
          <path d="m-11 11-11 19 15-6M11 11l11 19-15-6M-5 29l5 17 5-17" stroke="var(--accent)" stroke-width="1.5" />
        </g>
        <circle cx="163" cy="339" r="3" fill="var(--accent)" />
        <path d="M163 339h74" stroke="currentColor" stroke-opacity=".3" />
        <text x="243" y="343" fill="currentColor" opacity=".5" font-size="9" font-family="monospace">KEEP EXPLORING</text>
      </svg>
      <div class="diagram-bottom">
        <span>IDEAS → MODELS → UNDERSTANDING</span><span class="accent"><ArrowIcon /></span>
      </div>
    </div>
  </section>

  <div class="discipline-band">
    <div class="shell">
      <span>AIRCRAFT DESIGN</span>
      <span>ROCKETRY &amp; SIMULATION</span>
      <span>MANUFACTURING &amp; DESIGN</span>
      <span>LINUX &amp; OPEN SOURCE</span>
    </div>
  </div>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">01 / THE WORK</div>
        <h2>Projects</h2>
      </div>
      <a class="text-link" href={url('projects/')}>All projects <ArrowIcon /></a>
    </div>
    <div class="project-grid">
      {projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="section-note">These initial project pages are proposed studies, with scope and methods outlined.</p>
  </section>

  <section class="shell section writing-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">02 / THE NOTEBOOK</div>
        <h2>Blogposts</h2>
      </div>
      <a class="text-link" href={url('writing/')}>All writing <ArrowIcon /></a>
    </div>
    <PostList posts={posts.slice(0, 3)} />
  </section>

  <section class="shell about-strip">
    <div class="eyebrow">ALWAYS ASKING WHY</div>
    <h2>Built on curiosity.<br />Grounded in engineering.</h2>
    <a class="text-link" href={url('about/')}>A little about me <ArrowIcon /></a>
  </section>
</Base>
