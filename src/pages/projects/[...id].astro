---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>!data.draft)).map(entry=>({params:{id:entry.id},props:{entry}}))}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<Article entry={entry} headings={headings} type="projects"><Content/></Article>
