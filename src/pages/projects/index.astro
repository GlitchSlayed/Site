---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
const projects=(await getCollection('projects',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Projects — Vansh"><section class="shell page-section"><div class="eyebrow">THE WORK</div><h1 class="page-title">Projects.</h1><p class="page-description">Questions worth exploring. Models worth building. A growing collection of aerospace and technical studies.</p><div class="notice">The initial entries below are proposed personal projects, not completed research or validated results.</div><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section></Base>
