---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
const projects=(await getCollection('projects',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Projects | Vansh" ogImagePath="og/projects.png" ogImageAlt="Vansh’s projects"><section class="shell page-section"><div class="eyebrow">THE WORK</div><h1 class="page-title">Projects.</h1><p class="page-description">Questions worth exploring. Models worth building. A growing collection of aerospace and technical studies.</p><div class="notice">I had some questions and ideas, so I figured I should share my findings with the World.</div><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section></Base>
