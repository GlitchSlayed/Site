---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../../config';
import { statusNotes } from '../../lib/editorial';
const projects = (await getCollection('projects', ({data})=>!data.draft)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||+b.data.date-+a.data.date);
const tags = [...new Set(projects.flatMap(p=>p.data.tags))].sort();
const statuses = [...new Set(projects.map(p=>p.data.status))];
---
<Base title="Projects | Vansh Datta" ogImagePath="og/projects.png">
<section class="shell page-section personal-catalogue">
<header class="personal-page-head"><p class="small-label">The workbench / Projects</p><h1 class="page-title">A question worth<br/><em>working through.</em></h1><p class="intro-deck">Airfoil experiments, aircraft trade studies, and software I want to exist. Here’s what I’m working on, including the parts I haven’t figured out yet.</p></header>
<div class="catalogue-summary">{statuses.map(s=><span><strong>{projects.filter(p=>p.data.status===s).length}</strong> {s}</span>)}</div>
<form class="catalogue-controls" id="project-controls" role="search" aria-label="Find a project">
<label>Find a project<input type="search" id="project-query" placeholder="Try airfoil, Fedora, simulation…" /></label>
<label>Topic<select id="project-topic"><option value="all">All topics</option>{tags.map(t=><option value={t}>{t}</option>)}</select></label>
<label>Stage<select id="project-stage"><option value="all">Every stage</option>{statuses.map(s=><option>{s}</option>)}</select></label>
<label>Order<select id="project-sort"><option value="selected">Selected first</option><option value="newest">Newest first</option><option value="title">A to Z</option></select></label>
<button type="reset" class="button">Reset</button>
</form>
<div class="register-view" role="group" aria-label="Project view" hidden><button type="button" data-view="cards" aria-pressed="true">Drawing cards</button><button type="button" data-view="register" aria-pressed="false">Engineering register</button></div>
<p id="project-count" role="status">{projects.length} projects in the notebook</p>
<div class="project-grid" id="project-catalogue">{projects.map((p,i)=><div class="project-grid-item" data-id={p.id} data-title={p.data.title} data-search={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')} ${p.data.engineering?.methods.join(' ') || ''} ${p.data.engineering?.question || ''}`.toLowerCase()} data-tags={JSON.stringify(p.data.tags)} data-status={p.data.status} data-date={+p.data.date} data-order={i}><ProjectCard project={p} /><p class="project-stage-note">{statusNotes[p.data.status]}</p></div>)}</div>
<div class="project-register" id="project-register" hidden role="region" aria-label="Engineering project register" tabindex="0"><table><caption>Project scope, methods, and the next check</caption><thead><tr><th scope="col">Project / stage</th><th scope="col">Question &amp; method</th><th scope="col">Next check</th></tr></thead><tbody>{projects.map(p=><tr data-id={p.id}><th scope="row"><a href={url(`projects/${p.id}/`)}>{p.data.title}</a><span>{p.data.status}</span></th><td>{p.data.engineering?.question || p.data.description}{p.data.engineering&&<small>{p.data.engineering.methods.join(' · ')}</small>}</td><td>{p.data.engineering?.nextCheck || 'See the project write-up for next steps.'}</td></tr>)}</tbody></table></div>
<div id="project-empty" class="empty-state" hidden><h2>No projects match those filters.</h2><p>Try a broader topic or reset the filters to see the whole workbench.</p></div>
<details class="status-guide"><summary>What the project stages mean</summary><dl>{Object.entries(statusNotes).map(([s,n])=><div><dt>{s}</dt><dd>{n}</dd></div>)}</dl></details>
<aside class="personal-letter"><p class="small-label">A note on what’s here</p><h2>Plans belong in the notebook, too.</h2><p>A concept page records a question and a possible way to answer it. It doesn’t mean I’ve built the hardware or run the experiment. Each project keeps its methods, assumptions, and remaining work together.</p></aside>
</section>
</Base>
<script>
const form = document.querySelector<HTMLFormElement>('#project-controls');
const grid = document.querySelector<HTMLElement>('#project-catalogue');
const register = document.querySelector<HTMLElement>('#project-register')!;
const rows = [...register.querySelectorAll<HTMLTableRowElement>('tbody tr')];
const items = [...document.querySelectorAll<HTMLElement>('.project-grid-item')];
const query = document.querySelector<HTMLInputElement>('#project-query')!;
const topic = document.querySelector<HTMLSelectElement>('#project-topic')!;
const stage = document.querySelector<HTMLSelectElement>('#project-stage')!;
const sort = document.querySelector<HTMLSelectElement>('#project-sort')!;
const viewButtons=[...document.querySelectorAll<HTMLButtonElement>('.register-view button')];
function setView(view:string){const table=view==='register';grid!.hidden=table;register.hidden=!table;viewButtons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===(table?'register':'cards'))));try{localStorage.setItem('project-view',table?'register':'cards');}catch{}}
viewButtons.forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view!)));
(document.querySelector('.register-view') as HTMLElement).hidden=false;
try{setView(localStorage.getItem('project-view')||'cards');}catch{setView('cards');}
function update() {
 let count=0;
 items.forEach(item=>{item.hidden=!(item.dataset.search!.includes(query.value.trim().toLowerCase()) && (topic.value==='all'||JSON.parse(item.dataset.tags!).includes(topic.value)) && (stage.value==='all'||item.dataset.status===stage.value)); if(!item.hidden)count++;});
 [...items].sort((a,b)=>sort.value==='title'?a.dataset.title!.localeCompare(b.dataset.title!):sort.value==='newest'?Number(b.dataset.date)-Number(a.dataset.date):Number(a.dataset.order)-Number(b.dataset.order)).forEach(item=>{grid?.append(item);const row=rows.find(r=>r.dataset.id===item.dataset.id);if(row){row.hidden=item.hidden;register.querySelector('tbody')!.append(row);}});
 document.querySelector('#project-count')!.textContent=`${count} of ${items.length} projects`;
 (document.querySelector('#project-empty') as HTMLElement).hidden=count>0;
}
form?.addEventListener('submit',e=>e.preventDefault());
form?.addEventListener('input',update);
form?.addEventListener('reset',()=>setTimeout(update,0));
</script>
