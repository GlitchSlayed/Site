---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../../layouts/BlogArticle.astro';
export async function getStaticPaths(){return (await getCollection('writing',({data})=>!data.draft)).map(entry=>({params:{id:entry.id},props:{entry}}))}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<BlogArticle entry={entry} headings={headings}><Content/></BlogArticle>
