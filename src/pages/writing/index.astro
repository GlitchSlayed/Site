---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url, dateLabel } from '../../config';
import { readingMinutes, slugifyTag } from '../../lib/editorial';
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
const tags=[...new Set(posts.flatMap(p=>p.data.tags))].sort();
const lead=posts.find(p=>!p.data.sample) || posts[0];
---
<Base title="The Notebook | Writing by Vansh Datta" ogImagePath="og/writing.png">
<section class="shell page-section personal-writing">
<header class="journal-masthead"><div class="journal-edition"><span>Written by Vansh Datta</span><span>Aerospace · Making · Computing</span></div><h1>The Notebook</h1><p>Things I’m building, things I’m questioning, things I wanted to understand.</p><div class="journal-edition"><span>{posts.length} articles in the archive</span><a href={url('rss.xml')}>Follow via RSS ↗</a></div></header>
<div class="journal-front">
{lead&&<article class="journal-lead"><p class="small-label">The latest / <a href={url(`writing/tags/${slugifyTag(lead.data.tags[0])}/`)}>{lead.data.tags[0]}</a>{lead.data.sample?' / Sample':''}</p><h2><a href={url(`writing/${lead.id}/`)}>{lead.data.title}</a></h2><p class="intro-deck">{lead.data.description}</p><p class="small-label"><time datetime={lead.data.date.toISOString()}>{dateLabel(lead.data.date)}</time> · {readingMinutes(lead.body)} min read</p><a class="text-link" href={url(`writing/${lead.id}/`)}>Open the story →</a></article>}
<aside class="editor-note"><p class="small-label">A note from me</p><h2>Room for a longer explanation.</h2><p>The project pages tell you what I’m working on. Here I write about why, what’s getting in the way, and what I’m learning along the way.</p><p class="note-signature">Vansh</p><a class="text-link" href={url('about/')}>Meet the author →</a></aside>
</div>
<section aria-labelledby="archive-title"><div class="section-heading"><h2 id="archive-title">Browse the notebook</h2><div class="inline-links"><a href={url('writing/tags/')} class="small-label text-link">Topic index →</a><span class="small-label">Newest first</span></div></div>
<form id="writing-controls" class="catalogue-controls" role="search" aria-label="Find an article"><label>Search the archive<input id="writing-query" type="search" placeholder="A title, a question, a topic…" /></label><label>Topic<select id="writing-topic"><option value="all">All topics</option>{tags.map(t=><option>{t}</option>)}</select></label><button type="reset" class="button">Reset</button></form>
<p id="writing-count" role="status">{posts.length} articles</p>
<div class="journal-archive">{posts.map((p,i)=><article class="journal-entry" data-search={`${p.data.title} ${p.data.description} ${p.body||''}`.toLowerCase()} data-tags={JSON.stringify(p.data.tags)}><div class="entry-date"><span class="entry-number">{String(i+1).padStart(2,'0')}</span><time datetime={p.data.date.toISOString()}>{dateLabel(p.data.date)}</time></div><div><p class="small-label">{p.data.tags.map((t, idx) => <Fragment key={t}><a href={url(`writing/tags/${slugifyTag(t)}/`)}>{t}</a>{idx < p.data.tags.length - 1 ? ' / ' : ''}</Fragment>)}{p.data.sample?' / Sample article':''}</p><h3><a href={url(`writing/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p><span class="small-label">{readingMinutes(p.body)} min read</span></div><a class="entry-open" href={url(`writing/${p.id}/`)} aria-label={`Read ${p.data.title}`}>↗</a></article>)}</div><p id="writing-empty" hidden class="empty-state">No articles match. Try fewer words or reset the topic.</p></section>
<footer class="personal-signoff"><h2>No publishing schedule. Just something worth writing.</h2><p>The RSS feed carries new posts whenever they’re published.</p><a class="text-link" href={url('rss.xml')}>Subscribe with your feed reader ↗</a></footer>
</section>
</Base>
<script>
const form=document.querySelector<HTMLFormElement>('#writing-controls');
const query=document.querySelector<HTMLInputElement>('#writing-query')!;
const topic=document.querySelector<HTMLSelectElement>('#writing-topic')!;
const items=[...document.querySelectorAll<HTMLElement>('.journal-entry')];
function update(){let count=0;items.forEach(item=>{item.hidden=!(item.dataset.search!.includes(query.value.trim().toLowerCase())&&(topic.value==='all'||JSON.parse(item.dataset.tags!).includes(topic.value)));if(!item.hidden)count++;});document.querySelector('#writing-count')!.textContent=`${count} of ${items.length} articles`;(document.querySelector('#writing-empty') as HTMLElement).hidden=count>0;}
form?.addEventListener('submit',e=>e.preventDefault());form?.addEventListener('input',update);form?.addEventListener('reset',()=>setTimeout(update,0));
</script>
