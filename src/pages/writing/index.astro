---
import Base from '../../layouts/Base.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import SearchIcon from '../../components/SearchIcon.astro';
import {getCollection} from 'astro:content';
import {url,dateLabel} from '../../config';
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<Base title="Writing | Vansh" ogImagePath="og/writing.png" ogImageAlt="Writing by Vansh"><section class="shell page-section"><div class="eyebrow">THE NOTEBOOK</div><h1 class="page-title">Writing.</h1><p class="page-description">Notes on aerospace, engineering, and the tools that help us understand them.</p><div class="writing-tools"><label class="search-box"><SearchIcon/><input type="search" id="search" placeholder="Search writing…" aria-label="Search writing"/></label><div class="filter-list" aria-label="Filter by topic"><button class="filter active" data-tag="all" aria-pressed="true">All</button>{tags.map(tag=><button class="filter" data-tag={tag} aria-pressed="false">{tag}</button>)}</div></div><p id="result-count" class="result-count" aria-live="polite">{posts.length} articles</p><div class="post-list">{posts.map(post=><article class="search-item" data-search={`${post.data.title} ${post.data.description} ${post.body||''}`.toLowerCase()} data-tags={JSON.stringify(post.data.tags)}><a class="post-row" href={url(`writing/${post.id}/`)}><div><div class="post-meta"><span>{post.data.tags.join(' / ')}</span><span>{dateLabel(post.data.date)}</span>{post.data.sample && <span class="sample-label">Sample</span>}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="row-arrow"><ArrowIcon/></span></a></article>)}</div><p id="empty" hidden>No articles match. Try another topic or search.</p></section></Base>
<script>
let selected='all';const input=document.querySelector<HTMLInputElement>('#search');const buttons=document.querySelectorAll<HTMLButtonElement>('[data-tag]');
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.search-item').forEach(item=>{const matches=(item.dataset.search||'').includes((input?.value||'').toLowerCase())&&(selected==='all'||JSON.parse(item.dataset.tags||'[]').includes(selected));item.hidden=!matches;if(matches)count++});const label=document.querySelector('#result-count');if(label)label.textContent=`${count} article${count===1?'':'s'}`;const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=count>0}
input?.addEventListener('input',filter);buttons.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.tag||'all';buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});filter()}));
</script>
