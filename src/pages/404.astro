---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { url } from '../config';
---

<Base
  title="404 | Page Not Found"
  ogImagePath="og/404.png"
  ogImageAlt="Page not found"
  noindex={true}
>
  <section class="shell page-section error-section" data-pagefind-ignore>
    <div class="error-container">
      <!-- Unmistakable 404 Headline & Status -->
      <div class="error-badge-row">
        <div class="error-badge" aria-hidden="true">
          <span class="error-code">404</span>
          <span class="error-badge-divider">/</span>
          <span class="error-badge-label">PAGE NOT FOUND</span>
        </div>
        <div class="error-status-chip">
          <span class="status-dot"></span>
          <span>HTTP 404 — UNRESOLVED ROUTE</span>
        </div>
      </div>

      <h1 class="page-title error-title">
        The page you’re looking for <br />
        <span class="accent-word"><em>doesn’t exist.</em></span>
      </h1>

      <p class="page-description">
        No document or project matches <code class="missing-path-code" id="missing-path-display">the requested URL</code>. It may have been moved, renamed, or never existed in the repository.
      </p>

      <!-- Immediate primary navigation for quick departure -->
      <div class="error-quick-nav">
        <a class="button primary" href={url()}>
          Return to Flight Deck <ArrowIcon />
        </a>
        <a class="button" href={url('writing/')}>
          Field Dispatches <ArrowIcon />
        </a>
        <a class="button" href={url('projects/')}>
          Engineering Monographs <ArrowIcon />
        </a>
        <a class="text-link" href={url('writing/tags/')}>
          Browse by Topic →
        </a>
      </div>

      <!-- Apollo AGC / Trajectory Correction Mini-Simulator -->
      <div class="simulator-wrapper" aria-label="Manual Vector Override Flight Simulator">
        <div class="sim-terminal-bar">
          <div class="sim-status-indicator">
            <span class="sim-blink-led"></span>
            <span class="sim-sys-name">AGC PROGRAM 404 // VECTOR RECOVERY</span>
            <span class="sim-score-chip" id="sim-score-chip">RECOVERIES: <strong id="sim-recoveries">0</strong></span>
          </div>
          <div class="sim-tools">
            <button type="button" id="sim-sas-toggle" class="sim-ctrl-btn active" aria-label="Toggle Stability Assist System" title="Toggle automatic leveling (SAS)">
              SAS: <span id="sim-sas-label">ON</span>
            </button>
            <button type="button" id="sim-audio-toggle" class="sim-ctrl-btn" aria-label="Toggle simulator sound" title="Toggle audio (M)">
              <span id="sim-audio-label">Sound: Off</span>
            </button>
            <button type="button" id="sim-reset-btn" class="sim-ctrl-btn" aria-label="Restart trajectory simulation" title="Restart simulation (R)">
              ↺ Reset Vector
            </button>
          </div>
        </div>

        <div class="sim-display-container">
          <canvas
            id="lander-canvas"
            width="640"
            height="320"
            role="img"
            aria-label="Interactive 2D vector lander simulation showing an off-course spacecraft attempting to touch down on Target Pad 404"
            tabindex="0"
            data-home={url()}
            data-writing={url('writing/')}
            data-projects={url('projects/')}
          ></canvas>
          <div id="sim-banner" class="sim-banner" role="status" aria-live="polite" hidden></div>
        </div>

        <div class="sim-control-pad" role="group" aria-label="Simulator Controls">
          <button type="button" id="sim-btn-left" class="sim-key-btn" aria-label="Fire Port RCS Thruster">
            ◀ Roll Port <kbd>A / ←</kbd>
          </button>
          <button type="button" id="sim-btn-thrust" class="sim-key-btn primary-thrust" aria-label="Fire Main Thruster">
            ▲ Main Thruster <kbd>W / ↑ / Space</kbd>
          </button>
          <button type="button" id="sim-btn-right" class="sim-key-btn" aria-label="Fire Starboard RCS Thruster">
            Roll Stbd ▶ <kbd>D / →</kbd>
          </button>
        </div>

        <div class="sim-instructions">
          <div class="guide-item"><strong>Objective:</strong> Touch down gently on <span class="pad-pill">[TARGET PAD 404]</span>.</div>
          <div class="guide-item"><strong>Guidance:</strong> Descent rate <span class="spec-val">&lt; 8.0 m/s</span> · Lateral rate <span class="spec-val">&lt; 5.2 m/s</span> · Attitude upright (&lt; 20°).</div>
          <div class="guide-item"><strong>Stability:</strong> <span class="spec-val">SAS ON</span> auto-stabilizes roll when keys are released.</div>
        </div>
      </div>

      <!-- Telemetry Diagnostics Box -->
      <div class="error-telemetry-box">
        <div class="telemetry-row">
          <span>VECTOR STATUS:</span>
          <span class="telemetry-warn">UNRESOLVED ROUTE (HTTP 404)</span>
        </div>
        <div class="telemetry-row">
          <span>NAVIGATION AID:</span>
          <span>IF YOU WERE FOLLOWING A LINK, IT MAY BE DEPRECATED OR MISSPELLED</span>
        </div>
        <div class="telemetry-row">
          <span>RECOMMENDED WAYPOINTS:</span>
          <span>FLIGHT DECK, FIELD DISPATCHES, OR TOPIC INDEX</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Self-contained Vector Recovery Simulator
  (function () {
    // Populate attempted path for maximum clarity
    const pathDisplay = document.getElementById('missing-path-display');
    if (pathDisplay) {
      try {
        const p = window.location.pathname;
        if (p && p.length > 0 && p !== '/') {
          pathDisplay.textContent = p;
        } else {
          pathDisplay.textContent = 'this URL';
        }
      } catch {
        pathDisplay.textContent = 'this URL';
      }
    }

    const canvas = document.getElementById('lander-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    if (!ctx) return;

    const banner = document.getElementById('sim-banner');
    const resetBtn = document.getElementById('sim-reset-btn');
    const audioToggle = document.getElementById('sim-audio-toggle');
    const audioLabel = document.getElementById('sim-audio-label');
    const sasToggle = document.getElementById('sim-sas-toggle');
    const sasLabel = document.getElementById('sim-sas-label');
    const recoveriesLabel = document.getElementById('sim-recoveries');
    const btnLeft = document.getElementById('sim-btn-left');
    const btnRight = document.getElementById('sim-btn-right');
    const btnThrust = document.getElementById('sim-btn-thrust');

    let soundEnabled = false;
    let sasEnabled = true;
    let recoveries = 0;
    let audioCtx: AudioContext | null = null;
    let thrustGain: GainNode | null = null;
    let thrustNoise: AudioBufferSourceNode | null = null;

    function initAudio() {
      if (!audioCtx) {
        const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        audioCtx = new AudioClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function toggleAudio() {
      soundEnabled = !soundEnabled;
      if (soundEnabled) {
        initAudio();
        if (audioLabel) audioLabel.textContent = 'Sound: On';
      } else {
        stopThrustSound();
        if (audioLabel) audioLabel.textContent = 'Sound: Off';
      }
    }

    function toggleSas() {
      sasEnabled = !sasEnabled;
      if (sasLabel) sasLabel.textContent = sasEnabled ? 'ON' : 'OFF';
      if (sasToggle) {
        if (sasEnabled) {
          sasToggle.classList.add('active');
        } else {
          sasToggle.classList.remove('active');
        }
      }
    }

    function playBeep(freq: number, type: OscillatorType, dur: number) {
      if (!soundEnabled || !audioCtx) return;
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + dur);
      } catch {
        // audio fail-safe
      }
    }

    function startThrustSound() {
      if (!soundEnabled || !audioCtx || thrustGain) return;
      try {
        const bufferSize = audioCtx.sampleRate * 2;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }

        thrustNoise = audioCtx.createBufferSource();
        thrustNoise.buffer = noiseBuffer;
        thrustNoise.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(260, audioCtx.currentTime);

        thrustGain = audioCtx.createGain();
        thrustGain.gain.setValueAtTime(0.09, audioCtx.currentTime);

        thrustNoise.connect(filter);
        filter.connect(thrustGain);
        thrustGain.connect(audioCtx.destination);
        thrustNoise.start();
      } catch {
        // fail-safe
      }
    }

    function stopThrustSound() {
      if (thrustGain && audioCtx) {
        try {
          thrustGain.gain.setValueAtTime(0, audioCtx.currentTime);
          thrustNoise?.stop();
        } catch {
          // fail-safe
        }
        thrustGain = null;
        thrustNoise = null;
      }
    }

    // Vehicle & Environment Tuning
    // Gravity: floaty and forgiving (0.036 vs old 0.055)
    const gravity = 0.036;
    // Thrust: ample authority (~2.3:1 thrust-to-weight)
    const thrustPower = 0.082;
    // Rotation rate: smooth and controllable
    const turnRate = 0.024;
    // Landing pad: generous 150px wide target
    const pad = { x: 235, y: 285, width: 155 };

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      color: string;
      size: number;
    }

    let particles: Particle[] = [];

    const ship = {
      x: 100,
      y: 55,
      vx: 0.25,
      vy: 0.05,
      angle: 0.0, // in radians
      fuel: 100,
      thrusting: false,
      turningLeft: false,
      turningRight: false,
      state: 'flying' as 'flying' | 'landed' | 'crashed',
    };

    function resetShip() {
      ship.x = 90 + Math.random() * 70;
      ship.y = 45 + Math.random() * 25;
      ship.vx = 0.2 + Math.random() * 0.25; // Gentle horizontal drift
      ship.vy = 0.05;
      ship.angle = 0; // Starts upright
      ship.fuel = 100;
      ship.thrusting = false;
      ship.turningLeft = false;
      ship.turningRight = false;
      ship.state = 'flying';
      particles = [];
      stopThrustSound();
      if (banner) {
        banner.hidden = true;
        banner.innerHTML = '';
      }
    }

    // Input management
    const keys: Record<string, boolean> = {};

    window.addEventListener('keydown', (e) => {
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
        if (document.activeElement === canvas) {
          e.preventDefault();
        }
      }
      keys[e.key.toLowerCase()] = true;
      if (e.key.toLowerCase() === 'r') resetShip();
      if (e.key.toLowerCase() === 'm') toggleAudio();
      if (e.key.toLowerCase() === 's') toggleSas();
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    // Touch / Button listeners
    function bindBtn(el: HTMLElement | null, onDown: () => void, onUp: () => void) {
      if (!el) return;
      const down = (e: Event) => {
        e.preventDefault();
        onDown();
      };
      const up = (e: Event) => {
        e.preventDefault();
        onUp();
      };
      el.addEventListener('mousedown', down);
      el.addEventListener('mouseup', up);
      el.addEventListener('mouseleave', up);
      el.addEventListener('touchstart', down, { passive: false });
      el.addEventListener('touchend', up, { passive: false });
    }

    bindBtn(btnLeft, () => { keys['arrowleft'] = true; }, () => { keys['arrowleft'] = false; });
    bindBtn(btnRight, () => { keys['arrowright'] = true; }, () => { keys['arrowright'] = false; });
    bindBtn(btnThrust, () => { keys['arrowup'] = true; }, () => { keys['arrowup'] = false; });
    resetBtn?.addEventListener('click', resetShip);
    audioToggle?.addEventListener('click', toggleAudio);
    sasToggle?.addEventListener('click', toggleSas);

    // Terrain profile
    const terrain = [
      { x: 0, y: 260 },
      { x: 80, y: 280 },
      { x: 170, y: 270 },
      { x: pad.x, y: pad.y },
      { x: pad.x + pad.width, y: pad.y },
      { x: 450, y: 265 },
      { x: 550, y: 290 },
      { x: 640, y: 275 },
    ];

    function getTerrainY(x: number) {
      for (let i = 0; i < terrain.length - 1; i++) {
        const p1 = terrain[i];
        const p2 = terrain[i + 1];
        if (x >= p1.x && x <= p2.x) {
          const t = (x - p1.x) / (p2.x - p1.x);
          return p1.y + t * (p2.y - p1.y);
        }
      }
      return 290;
    }

    let animationFrameId: number;
    let beaconTick = 0;

    function loop() {
      beaconTick++;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Update inputs
      if (ship.state === 'flying') {
        ship.turningLeft = keys['arrowleft'] || keys['a'] || false;
        ship.turningRight = keys['arrowright'] || keys['d'] || false;
        ship.thrusting = (keys['arrowup'] || keys['w'] || keys[' '] || false) && ship.fuel > 0;

        if (ship.turningLeft) {
          ship.angle -= turnRate;
          playBeep(420, 'triangle', 0.025);
        } else if (ship.turningRight) {
          ship.angle += turnRate;
          playBeep(460, 'triangle', 0.025);
        } else if (sasEnabled) {
          // SAS Attitude Hold: gently restore level orientation when pilot releases steering
          ship.angle *= 0.94;
          if (Math.abs(ship.angle) < 0.004) ship.angle = 0;
        }

        if (ship.thrusting) {
          ship.vx += Math.sin(ship.angle) * thrustPower;
          ship.vy -= Math.cos(ship.angle) * thrustPower;
          // Economical fuel consumption (gives ~17s of continuous burn)
          ship.fuel = Math.max(0, ship.fuel - 0.10);
          startThrustSound();

          // Spawn engine exhaust particles
          const exhaustAngle = ship.angle + Math.PI + (Math.random() - 0.5) * 0.3;
          const speed = 2.2 + Math.random() * 1.8;
          particles.push({
            x: ship.x,
            y: ship.y + 10,
            vx: Math.sin(exhaustAngle) * speed + ship.vx * 0.2,
            vy: -Math.cos(exhaustAngle) * speed + ship.vy * 0.2,
            life: 1,
            maxLife: 16 + Math.random() * 10,
            color: Math.random() > 0.4 ? '#E25835' : '#F5B041',
            size: 2.5,
          });
        } else {
          stopThrustSound();
        }

        // Apply gravity and inertia
        ship.vy += gravity;
        ship.x += ship.vx;
        ship.y += ship.vy;

        // Wrap around horizontally
        if (ship.x < 0) ship.x = 640;
        if (ship.x > 640) ship.x = 0;

        // Ground collision check
        const groundY = getTerrainY(ship.x);
        if (ship.y + 12 >= groundY) {
          ship.y = groundY - 12;
          stopThrustSound();

          // Touchdown parameters
          const onPad = ship.x >= pad.x + 6 && ship.x <= pad.x + pad.width - 6;
          const softVertical = ship.vy < 2.0; // < 8.0 m/s
          const softHorizontal = Math.abs(ship.vx) < 1.3; // < 5.2 m/s
          const upright = Math.abs(ship.angle) < 0.35; // ~20 degrees

          if (onPad && softVertical && softHorizontal && upright) {
            ship.state = 'landed';
            ship.vx = 0;
            ship.vy = 0;
            ship.angle = 0;
            recoveries++;
            if (recoveriesLabel) recoveriesLabel.textContent = String(recoveries);

            playBeep(880, 'sine', 0.3);
            setTimeout(() => playBeep(1174, 'sine', 0.4), 180);

            // Celebration sparks
            for (let i = 0; i < 30; i++) {
              const ang = Math.random() * Math.PI * 2;
              const spd = 1.2 + Math.random() * 3.5;
              particles.push({
                x: ship.x,
                y: ship.y,
                vx: Math.cos(ang) * spd,
                vy: Math.sin(ang) * spd,
                life: 1,
                maxLife: 35 + Math.random() * 20,
                color: Math.random() > 0.5 ? '#5CD068' : '#F5B041',
                size: 3,
              });
            }

            if (banner) {
              banner.hidden = false;
              banner.innerHTML = `
                <div class="banner-success">
                  <strong>✔ TOUCHDOWN NOMINAL!</strong>
                  Airframe secured on Target Pad 404 with ${Math.round(ship.fuel)}% fuel remaining.<br/>
                  <div class="banner-stats">
                    <span>Descent: ${(ship.vy * 4).toFixed(1)} m/s</span>
                    <span>Total Recoveries: ${recoveries}</span>
                  </div>
                  <div class="banner-links">
                    <a href="${canvas.dataset.home || '/Site/'}" class="button primary">Enter Flight Deck →</a>
                    <a href="${canvas.dataset.writing || '/Site/writing/'}" class="text-link">Field Dispatches →</a>
                    <button type="button" class="sim-retry-btn" id="banner-fly-again">↺ Fly Again (R)</button>
                  </div>
                </div>
              `;
              document.getElementById('banner-fly-again')?.addEventListener('click', resetShip);
            }
          } else {
            ship.state = 'crashed';
            playBeep(130, 'sawtooth', 0.5);

            // Diagnostic feedback explaining WHY the crash happened
            let crashReason = 'Structural overload: Exceeded flight envelope.';
            if (!onPad) {
              crashReason = 'Missed Target Pad 404: Touched down on uneven lunar rock.';
            } else if (!softVertical) {
              crashReason = `Hard landing: Descent rate ${(ship.vy * 4).toFixed(1)} m/s exceeded 8.0 m/s gear limit.`;
            } else if (!softHorizontal) {
              crashReason = `Lateral shear: Horizontal velocity ${(Math.abs(ship.vx) * 4).toFixed(1)} m/s exceeded 5.2 m/s limit.`;
            } else if (!upright) {
              crashReason = `Airframe rollover: Touchdown tilt (${Math.round(Math.abs(ship.angle) * 180 / Math.PI)}°) exceeded 20° stability envelope.`;
            }

            // Explosion particles
            for (let i = 0; i < 28; i++) {
              const ang = Math.random() * Math.PI * 2;
              const spd = 1 + Math.random() * 3.5;
              particles.push({
                x: ship.x,
                y: ship.y,
                vx: Math.cos(ang) * spd,
                vy: Math.sin(ang) * spd,
                life: 1,
                maxLife: 25 + Math.random() * 15,
                color: Math.random() > 0.5 ? '#B83E18' : '#747065',
                size: 2.5,
              });
            }

            if (banner) {
              banner.hidden = false;
              banner.innerHTML = `
                <div class="banner-fail">
                  <strong>⚠ TOUCHDOWN DEVIATION</strong>
                  ${crashReason}<br/>
                  <div class="banner-hint">Tip: Use short thrust bursts and let SAS auto-level your attitude.</div>
                  <div class="banner-links">
                    <button type="button" class="button primary" id="banner-retry">↺ Recalibrate Vector (R)</button>
                    <a href="${canvas.dataset.home || '/Site/'}" class="text-link">Exit to Flight Deck →</a>
                  </div>
                </div>
              `;
              document.getElementById('banner-retry')?.addEventListener('click', resetShip);
            }
          }
        }
      }

      // Render Scene
      const isDark = document.documentElement.dataset.theme === 'dark';
      const inkColor = isDark ? '#EDE8DE' : '#1C1B18';
      const faintColor = isDark ? '#2E2C26' : '#E5DFD1';
      const accentColor = isDark ? '#E25835' : '#B83E18';
      const safeColor = isDark ? '#5CD068' : '#1D8338';
      const bgColor = isDark ? '#161614' : '#F8F6F0';

      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Radar Grid
      ctx.strokeStyle = faintColor;
      ctx.lineWidth = 1;
      for (let x = 40; x < canvas.width; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 40; y < canvas.height; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      // Draw Landing Alignment Guide Beam when ship is over pad
      if (ship.x >= pad.x && ship.x <= pad.x + pad.width && ship.state === 'flying') {
        ctx.fillStyle = isDark ? 'rgba(92, 208, 104, 0.05)' : 'rgba(29, 131, 56, 0.05)';
        ctx.fillRect(pad.x, 0, pad.width, pad.y);

        ctx.strokeStyle = isDark ? 'rgba(92, 208, 104, 0.25)' : 'rgba(29, 131, 56, 0.25)';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(pad.x, 0);
        ctx.lineTo(pad.x, pad.y);
        ctx.moveTo(pad.x + pad.width, 0);
        ctx.lineTo(pad.x + pad.width, pad.y);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Draw Terrain
      ctx.beginPath();
      ctx.moveTo(terrain[0].x, terrain[0].y);
      for (let i = 1; i < terrain.length; i++) {
        ctx.lineTo(terrain[i].x, terrain[i].y);
      }
      ctx.lineTo(canvas.width, canvas.height);
      ctx.lineTo(0, canvas.height);
      ctx.closePath();
      ctx.fillStyle = isDark ? '#1F1E1B' : '#EFECE3';
      ctx.fill();

      ctx.strokeStyle = inkColor;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(terrain[0].x, terrain[0].y);
      for (let i = 1; i < terrain.length; i++) {
        ctx.lineTo(terrain[i].x, terrain[i].y);
      }
      ctx.stroke();

      // Draw Landing Pad
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(pad.x, pad.y);
      ctx.lineTo(pad.x + pad.width, pad.y);
      ctx.stroke();

      // Blinking Runway Beacons at Pad Edges
      const beaconOn = Math.floor(beaconTick / 25) % 2 === 0;
      ctx.fillStyle = beaconOn ? safeColor : faintColor;
      ctx.beginPath();
      ctx.arc(pad.x + 3, pad.y - 3, 3, 0, Math.PI * 2);
      ctx.arc(pad.x + pad.width - 3, pad.y - 3, 3, 0, Math.PI * 2);
      ctx.fill();

      // Pad Label
      ctx.fillStyle = accentColor;
      ctx.font = '10px monospace';
      ctx.fillText('[TARGET PAD 404 // CLEAR FOR RECOVERY]', pad.x + 6, pad.y + 16);

      // Update & Draw Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life++;
        if (p.life >= p.maxLife) {
          particles.splice(i, 1);
          continue;
        }
        ctx.fillStyle = p.color;
        const size = Math.max(1, p.size * (1 - p.life / p.maxLife));
        ctx.fillRect(p.x, p.y, size, size);
      }

      // Draw Flight Vector Predictor
      if (ship.state === 'flying') {
        const vecSafe = ship.vy < 2.0 && Math.abs(ship.vx) < 1.3 && Math.abs(ship.angle) < 0.35;
        ctx.strokeStyle = vecSafe ? safeColor : accentColor;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ship.x, ship.y);
        ctx.lineTo(ship.x + ship.vx * 16, ship.y + ship.vy * 16);
        ctx.stroke();
      }

      // Draw Ship
      if (ship.state !== 'crashed') {
        ctx.save();
        ctx.translate(ship.x, ship.y);
        ctx.rotate(ship.angle);

        // Lander Body
        ctx.strokeStyle = inkColor;
        ctx.fillStyle = isDark ? '#2A2925' : '#FFFFFF';
        ctx.lineWidth = 1.6;

        // Command module capsule
        ctx.beginPath();
        ctx.moveTo(0, -12);
        ctx.lineTo(7, 2);
        ctx.lineTo(-7, 2);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Equipment module
        ctx.strokeRect(-8, 2, 16, 7);

        // Landing legs
        ctx.beginPath();
        ctx.moveTo(-8, 7);
        ctx.lineTo(-12, 14);
        ctx.lineTo(-15, 14);
        ctx.moveTo(8, 7);
        ctx.lineTo(12, 14);
        ctx.lineTo(15, 14);
        ctx.stroke();

        // Nozzle
        ctx.beginPath();
        ctx.moveTo(-4, 9);
        ctx.lineTo(4, 9);
        ctx.lineTo(2, 13);
        ctx.lineTo(-2, 13);
        ctx.closePath();
        ctx.fillStyle = accentColor;
        ctx.fill();
        ctx.stroke();

        // Thruster plume
        if (ship.thrusting) {
          ctx.beginPath();
          ctx.moveTo(-3, 13);
          ctx.lineTo(0, 18 + Math.random() * 8);
          ctx.lineTo(3, 13);
          ctx.fillStyle = accentColor;
          ctx.fill();
        }

        ctx.restore();
      }

      // Telemetry HUD overlay
      ctx.fillStyle = inkColor;
      ctx.font = '10.5px monospace';
      ctx.fillText(`ALT: ${Math.max(0, Math.round((pad.y - ship.y) * 4))} M`, 14, 22);

      const vSafe = ship.vy < 2.0;
      const vColor = vSafe ? safeColor : accentColor;
      ctx.fillStyle = vColor;
      ctx.fillText(`V_VERT: ${ship.vy >= 0 ? '+' : ''}${(ship.vy * 4).toFixed(1)} M/S ${vSafe ? '[SAFE]' : '[WARN]'}`, 14, 38);

      const hSafe = Math.abs(ship.vx) < 1.3;
      const hColor = hSafe ? safeColor : accentColor;
      ctx.fillStyle = hColor;
      ctx.fillText(`V_HORIZ: ${ship.vx >= 0 ? '+' : ''}${(ship.vx * 4).toFixed(1)} M/S ${hSafe ? '[SAFE]' : '[WARN]'}`, 14, 54);

      // Attitude tilt readout
      const deg = Math.round(ship.angle * 180 / Math.PI);
      const angleSafe = Math.abs(ship.angle) < 0.35;
      ctx.fillStyle = angleSafe ? safeColor : accentColor;
      ctx.fillText(`ATTITUDE: ${deg >= 0 ? '+' : ''}${deg}° ${angleSafe ? '[SAFE]' : '[WARN]'}`, 14, 70);

      // Fuel bar
      ctx.fillStyle = inkColor;
      ctx.fillText(`FUEL: ${Math.round(ship.fuel)}%`, 14, 86);
      ctx.strokeStyle = faintColor;
      ctx.strokeRect(78, 78, 50, 8);
      ctx.fillStyle = ship.fuel > 20 ? safeColor : accentColor;
      ctx.fillRect(79, 79, Math.max(0, (ship.fuel / 100) * 48), 6);

      if (!prefersReduced) {
        animationFrameId = requestAnimationFrame(loop);
      }
    }

    resetShip();
    animationFrameId = requestAnimationFrame(loop);

    // Canvas focus for keyboard control
    canvas.addEventListener('click', () => {
      canvas.focus();
    });

    // Cleanup when navigating away
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      stopThrustSound();
    });
  })();
</script>

