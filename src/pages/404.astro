---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { url } from '../config';
---

<Base
  title="404 | Trajectory Off Course"
  ogImagePath="og/404.png"
  ogImageAlt="Page not found"
  noindex={true}
>
  <section class="shell page-section error-section" data-pagefind-ignore>
    <div class="error-container">
      <div class="eyebrow">
        <span class="status-dot"></span>
        <span>TELEMETRY ERROR // 404 DEVIATION</span>
      </div>

      <h1 class="page-title error-title">
        Trajectory deviated from <br />
        <span class="accent-word"><em>charted airspace.</em></span>
      </h1>

      <p class="page-description">
        The requested coordinate does not exist in the engineering archives or field dispatches. Let's recalculate your vector and return to familiar coordinates.
      </p>

      <!-- Apollo AGC / Trajectory Correction Mini-Simulator -->
      <div class="simulator-wrapper" aria-label="Manual Vector Override Flight Simulator">
        <div class="sim-terminal-bar">
          <div class="sim-status-indicator">
            <span class="sim-blink-led"></span>
            <span class="sim-sys-name">AGC PROGRAM 404 // MANUAL VECTOR CORRECTION</span>
          </div>
          <div class="sim-tools">
            <button type="button" id="sim-audio-toggle" class="sim-ctrl-btn" aria-label="Toggle simulator sound" title="Toggle audio (M)">
              <span id="sim-audio-label">Sound: Off</span>
            </button>
            <button type="button" id="sim-reset-btn" class="sim-ctrl-btn" aria-label="Restart trajectory simulation" title="Restart simulation (R)">
              ↺ Reset Vector
            </button>
          </div>
        </div>

        <div class="sim-display-container">
          <canvas
            id="lander-canvas"
            width="640"
            height="320"
            role="img"
            aria-label="Interactive 2D vector lander simulation showing an off-course spacecraft attempting to touch down on Target Pad 404"
            tabindex="0"
          ></canvas>
          <div id="sim-hud-overlay" class="sim-hud" aria-hidden="true"></div>
          <div id="sim-banner" class="sim-banner" role="status" aria-live="polite" hidden></div>
        </div>

        <div class="sim-control-pad" role="group" aria-label="Simulator Controls">
          <button type="button" id="sim-btn-left" class="sim-key-btn" aria-label="Fire Port RCS Thruster">
            ◀ Roll Port <kbd>A / ←</kbd>
          </button>
          <button type="button" id="sim-btn-thrust" class="sim-key-btn primary-thrust" aria-label="Fire Main Thruster">
            ▲ Main Thruster <kbd>W / ↑ / Space</kbd>
          </button>
          <button type="button" id="sim-btn-right" class="sim-key-btn" aria-label="Fire Starboard RCS Thruster">
            Roll Stbd ▶ <kbd>D / →</kbd>
          </button>
        </div>

        <div class="sim-instructions">
          <span>Guidance: Touch down gently on <strong>[TARGET PAD 404]</strong>. Keep descent velocity <span class="spec-val">&lt; 1.8 m/s</span> and attitude upright.</span>
        </div>
      </div>

      <!-- Quick Navigation Actions -->
      <div class="error-telemetry-box">
        <div class="telemetry-row">
          <span>VECTOR STATUS:</span>
          <span class="telemetry-warn">UNRESOLVED COORDINATE (HTTP 404)</span>
        </div>
        <div class="telemetry-row">
          <span>RECOMMENDED WAYPOINTS:</span>
          <span>FLIGHT DECK, MONOGRAPHS, OR ARCHIVE</span>
        </div>
      </div>

      <div class="error-actions">
        <a class="button primary" href={url()}>
          Return to Flight Deck <ArrowIcon />
        </a>
        <a class="button" href={url('projects/')}>
          Engineering Monographs <ArrowIcon />
        </a>
        <a class="text-link" href={url('writing/')}>
          Field Dispatches <ArrowIcon />
        </a>
        <a class="text-link" href={url('writing/tags/')}>
          Topic Index <ArrowIcon />
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Self-contained Vector Recovery Simulator
  (function () {
    const canvas = document.getElementById('lander-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    if (!ctx) return;

    const banner = document.getElementById('sim-banner');
    const resetBtn = document.getElementById('sim-reset-btn');
    const audioToggle = document.getElementById('sim-audio-toggle');
    const audioLabel = document.getElementById('sim-audio-label');
    const btnLeft = document.getElementById('sim-btn-left');
    const btnRight = document.getElementById('sim-btn-right');
    const btnThrust = document.getElementById('sim-btn-thrust');

    let soundEnabled = false;
    let audioCtx: AudioContext | null = null;
    let thrustGain: GainNode | null = null;
    let thrustNoise: AudioBufferSourceNode | null = null;

    function initAudio() {
      if (!audioCtx) {
        const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        audioCtx = new AudioClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function toggleAudio() {
      soundEnabled = !soundEnabled;
      if (soundEnabled) {
        initAudio();
        if (audioLabel) audioLabel.textContent = 'Sound: On';
      } else {
        stopThrustSound();
        if (audioLabel) audioLabel.textContent = 'Sound: Off';
      }
    }

    function playBeep(freq: number, type: OscillatorType, dur: number) {
      if (!soundEnabled || !audioCtx) return;
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + dur);
      } catch {
        // audio fail-safe
      }
    }

    function startThrustSound() {
      if (!soundEnabled || !audioCtx || thrustGain) return;
      try {
        const bufferSize = audioCtx.sampleRate * 2;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }

        thrustNoise = audioCtx.createBufferSource();
        thrustNoise.buffer = noiseBuffer;
        thrustNoise.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(320, audioCtx.currentTime);

        thrustGain = audioCtx.createGain();
        thrustGain.gain.setValueAtTime(0.14, audioCtx.currentTime);

        thrustNoise.connect(filter);
        filter.connect(thrustGain);
        thrustGain.connect(audioCtx.destination);
        thrustNoise.start();
      } catch {
        // fail-safe
      }
    }

    function stopThrustSound() {
      if (thrustGain && audioCtx) {
        try {
          thrustGain.gain.setValueAtTime(0, audioCtx.currentTime);
          thrustNoise?.stop();
        } catch {
          // fail-safe
        }
        thrustGain = null;
        thrustNoise = null;
      }
    }

    // Vehicle state
    const gravity = 0.055;
    const pad = { x: 270, y: 285, width: 95 };

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      color: string;
    }

    let particles: Particle[] = [];

    const ship = {
      x: 80,
      y: 60,
      vx: 1.1,
      vy: 0.2,
      angle: 0.15, // in radians
      fuel: 100,
      thrusting: false,
      turningLeft: false,
      turningRight: false,
      state: 'flying' as 'flying' | 'landed' | 'crashed',
    };

    function resetShip() {
      ship.x = 75 + Math.random() * 50;
      ship.y = 50 + Math.random() * 30;
      ship.vx = 0.8 + Math.random() * 0.6;
      ship.vy = 0.1;
      ship.angle = (Math.random() - 0.5) * 0.2;
      ship.fuel = 100;
      ship.thrusting = false;
      ship.turningLeft = false;
      ship.turningRight = false;
      ship.state = 'flying';
      particles = [];
      stopThrustSound();
      if (banner) {
        banner.hidden = true;
        banner.innerHTML = '';
      }
    }

    // Input management
    const keys: Record<string, boolean> = {};

    window.addEventListener('keydown', (e) => {
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
        if (document.activeElement === canvas) {
          e.preventDefault();
        }
      }
      keys[e.key.toLowerCase()] = true;
      if (e.key.toLowerCase() === 'r') resetShip();
      if (e.key.toLowerCase() === 'm') toggleAudio();
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    // Touch / Button listeners
    function bindBtn(el: HTMLElement | null, onDown: () => void, onUp: () => void) {
      if (!el) return;
      const down = (e: Event) => {
        e.preventDefault();
        onDown();
      };
      const up = (e: Event) => {
        e.preventDefault();
        onUp();
      };
      el.addEventListener('mousedown', down);
      el.addEventListener('mouseup', up);
      el.addEventListener('mouseleave', up);
      el.addEventListener('touchstart', down, { passive: false });
      el.addEventListener('touchend', up, { passive: false });
    }

    bindBtn(btnLeft, () => { keys['arrowleft'] = true; }, () => { keys['arrowleft'] = false; });
    bindBtn(btnRight, () => { keys['arrowright'] = true; }, () => { keys['arrowright'] = false; });
    bindBtn(btnThrust, () => { keys['arrowup'] = true; }, () => { keys['arrowup'] = false; });
    resetBtn?.addEventListener('click', resetShip);
    audioToggle?.addEventListener('click', toggleAudio);

    // Terrain profile
    const terrain = [
      { x: 0, y: 260 },
      { x: 90, y: 285 },
      { x: 190, y: 270 },
      { x: pad.x, y: pad.y },
      { x: pad.x + pad.width, y: pad.y },
      { x: 440, y: 265 },
      { x: 540, y: 290 },
      { x: 640, y: 275 },
    ];

    function getTerrainY(x: number) {
      for (let i = 0; i < terrain.length - 1; i++) {
        const p1 = terrain[i];
        const p2 = terrain[i + 1];
        if (x >= p1.x && x <= p2.x) {
          const t = (x - p1.x) / (p2.x - p1.x);
          return p1.y + t * (p2.y - p1.y);
        }
      }
      return 290;
    }

    let animationFrameId: number;

    function loop() {
      // Check prefers-reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Update inputs
      if (ship.state === 'flying') {
        ship.turningLeft = keys['arrowleft'] || keys['a'] || false;
        ship.turningRight = keys['arrowright'] || keys['d'] || false;
        ship.thrusting = (keys['arrowup'] || keys['w'] || keys[' '] || false) && ship.fuel > 0;

        if (ship.turningLeft) {
          ship.angle -= 0.045;
          playBeep(440, 'triangle', 0.03);
        }
        if (ship.turningRight) {
          ship.angle += 0.045;
          playBeep(480, 'triangle', 0.03);
        }

        if (ship.thrusting) {
          const power = 0.13;
          ship.vx += Math.sin(ship.angle) * power;
          ship.vy -= Math.cos(ship.angle) * power;
          ship.fuel = Math.max(0, ship.fuel - 0.28);
          startThrustSound();

          // Spawn engine exhaust particles
          const exhaustAngle = ship.angle + Math.PI + (Math.random() - 0.5) * 0.35;
          const speed = 2.5 + Math.random() * 2;
          particles.push({
            x: ship.x,
            y: ship.y + 10,
            vx: Math.sin(exhaustAngle) * speed + ship.vx * 0.3,
            vy: -Math.cos(exhaustAngle) * speed + ship.vy * 0.3,
            life: 1,
            maxLife: 18 + Math.random() * 10,
            color: Math.random() > 0.4 ? '#E25835' : '#F5B041',
          });
        } else {
          stopThrustSound();
        }

        // Apply gravity and inertia
        ship.vy += gravity;
        ship.x += ship.vx;
        ship.y += ship.vy;

        // Wrap around horizontally
        if (ship.x < 0) ship.x = 640;
        if (ship.x > 640) ship.x = 0;

        // Ground collision check
        const groundY = getTerrainY(ship.x);
        if (ship.y + 12 >= groundY) {
          ship.y = groundY - 12;
          stopThrustSound();

          const onPad = ship.x >= pad.x + 8 && ship.x <= pad.x + pad.width - 8;
          const softVertical = ship.vy < 1.75;
          const softHorizontal = Math.abs(ship.vx) < 0.95;
          const upright = Math.abs(ship.angle) < 0.22; // ~12 degrees

          if (onPad && softVertical && softHorizontal && upright) {
            ship.state = 'landed';
            ship.vx = 0;
            ship.vy = 0;
            ship.angle = 0;
            playBeep(880, 'sine', 0.4);
            setTimeout(() => playBeep(1174, 'sine', 0.5), 200);

            if (banner) {
              banner.hidden = false;
              banner.innerHTML = `
                <div class="banner-success">
                  <strong>✔ TOUCHDOWN NOMINAL!</strong> Trajectory coordinates restored at Target Pad 404.<br/>
                  <div class="banner-links">
                    <a href="${canvas.dataset.home || '/Site/'}" class="button primary">Enter Flight Deck →</a>
                    <a href="${canvas.dataset.writing || '/Site/writing/'}" class="text-link">Field Dispatches →</a>
                  </div>
                </div>
              `;
            }
          } else {
            ship.state = 'crashed';
            playBeep(140, 'sawtooth', 0.6);

            // Explosion particles
            for (let i = 0; i < 28; i++) {
              const ang = Math.random() * Math.PI * 2;
              const spd = 1 + Math.random() * 4;
              particles.push({
                x: ship.x,
                y: ship.y,
                vx: Math.cos(ang) * spd,
                vy: Math.sin(ang) * spd,
                life: 1,
                maxLife: 25 + Math.random() * 15,
                color: Math.random() > 0.5 ? '#B83E18' : '#747065',
              });
            }

            if (banner) {
              banner.hidden = false;
              banner.innerHTML = `
                <div class="banner-fail">
                  <strong>⚠ IMPACT DEVIATION!</strong> Impact speed ${(ship.vy * 4).toFixed(1)} m/s exceeds airframe limit.
                  <button type="button" class="sim-retry-btn" id="banner-retry">↺ Recalibrate Vector</button>
                </div>
              `;
              document.getElementById('banner-retry')?.addEventListener('click', resetShip);
            }
          }
        }
      }

      // Render Scene
      const isDark = document.documentElement.dataset.theme === 'dark';
      const inkColor = isDark ? '#EDE8DE' : '#1C1B18';
      const faintColor = isDark ? '#2E2C26' : '#E5DFD1';
      const accentColor = isDark ? '#E25835' : '#B83E18';
      const bgColor = isDark ? '#161614' : '#F8F6F0';

      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Radar Grid
      ctx.strokeStyle = faintColor;
      ctx.lineWidth = 1;
      for (let x = 40; x < canvas.width; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 40; y < canvas.height; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      // Draw Terrain
      ctx.beginPath();
      ctx.moveTo(terrain[0].x, terrain[0].y);
      for (let i = 1; i < terrain.length; i++) {
        ctx.lineTo(terrain[i].x, terrain[i].y);
      }
      ctx.lineTo(canvas.width, canvas.height);
      ctx.lineTo(0, canvas.height);
      ctx.closePath();
      ctx.fillStyle = isDark ? '#1F1E1B' : '#EFECE3';
      ctx.fill();

      ctx.strokeStyle = inkColor;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(terrain[0].x, terrain[0].y);
      for (let i = 1; i < terrain.length; i++) {
        ctx.lineTo(terrain[i].x, terrain[i].y);
      }
      ctx.stroke();

      // Draw Landing Pad
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 3.5;
      ctx.beginPath();
      ctx.moveTo(pad.x, pad.y);
      ctx.lineTo(pad.x + pad.width, pad.y);
      ctx.stroke();

      // Pad Label
      ctx.fillStyle = accentColor;
      ctx.font = '10px monospace';
      ctx.fillText('[TARGET PAD 404]', pad.x + 4, pad.y + 16);

      // Update & Draw Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life++;
        if (p.life >= p.maxLife) {
          particles.splice(i, 1);
          continue;
        }
        ctx.fillStyle = p.color;
        const size = Math.max(1, 3 * (1 - p.life / p.maxLife));
        ctx.fillRect(p.x, p.y, size, size);
      }

      // Draw Ship
      if (ship.state !== 'crashed') {
        ctx.save();
        ctx.translate(ship.x, ship.y);
        ctx.rotate(ship.angle);

        // Lander Body
        ctx.strokeStyle = inkColor;
        ctx.fillStyle = isDark ? '#2A2925' : '#FFFFFF';
        ctx.lineWidth = 1.6;

        // Command module capsule
        ctx.beginPath();
        ctx.moveTo(0, -12);
        ctx.lineTo(7, 2);
        ctx.lineTo(-7, 2);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Equipment module
        ctx.strokeRect(-8, 2, 16, 7);

        // Landing legs
        ctx.beginPath();
        ctx.moveTo(-8, 7);
        ctx.lineTo(-12, 14);
        ctx.lineTo(-15, 14);
        ctx.moveTo(8, 7);
        ctx.lineTo(12, 14);
        ctx.lineTo(15, 14);
        ctx.stroke();

        // Nozzle
        ctx.beginPath();
        ctx.moveTo(-4, 9);
        ctx.lineTo(4, 9);
        ctx.lineTo(2, 13);
        ctx.lineTo(-2, 13);
        ctx.closePath();
        ctx.fillStyle = accentColor;
        ctx.fill();
        ctx.stroke();

        // Thruster plume
        if (ship.thrusting) {
          ctx.beginPath();
          ctx.moveTo(-3, 13);
          ctx.lineTo(0, 18 + Math.random() * 8);
          ctx.lineTo(3, 13);
          ctx.fillStyle = accentColor;
          ctx.fill();
        }

        ctx.restore();
      }

      // Telemetry HUD overlay
      ctx.fillStyle = inkColor;
      ctx.font = '10.5px monospace';
      ctx.fillText(`ALT: ${Math.max(0, Math.round((pad.y - ship.y) * 4))} M`, 14, 22);

      const vColor = ship.vy < 1.75 ? (isDark ? '#5CD068' : '#1D8338') : accentColor;
      ctx.fillStyle = vColor;
      ctx.fillText(`V_VERT: ${ship.vy >= 0 ? '+' : ''}${(ship.vy * 4).toFixed(1)} M/S ${ship.vy < 1.75 ? '[SAFE]' : '[WARN]'}`, 14, 38);

      const hColor = Math.abs(ship.vx) < 0.95 ? (isDark ? '#5CD068' : '#1D8338') : accentColor;
      ctx.fillStyle = hColor;
      ctx.fillText(`V_HORIZ: ${ship.vx >= 0 ? '+' : ''}${(ship.vx * 4).toFixed(1)} M/S`, 14, 54);

      // Fuel bar
      ctx.fillStyle = inkColor;
      ctx.fillText(`FUEL: ${Math.round(ship.fuel)}%`, 14, 70);
      ctx.strokeStyle = faintColor;
      ctx.strokeRect(78, 62, 50, 8);
      ctx.fillStyle = ship.fuel > 20 ? (isDark ? '#5CD068' : '#1D8338') : accentColor;
      ctx.fillRect(79, 63, Math.max(0, (ship.fuel / 100) * 48), 6);

      if (!prefersReduced) {
        animationFrameId = requestAnimationFrame(loop);
      }
    }

    resetShip();
    animationFrameId = requestAnimationFrame(loop);

    // Canvas focus for keyboard control
    canvas.addEventListener('click', () => {
      canvas.focus();
    });

    // Cleanup when navigating away
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      stopThrustSound();
    });
  })();
</script>

<style>
  .error-section {
    padding: 48px 0 80px;
    max-width: 760px;
  }

  .error-container {
    display: flex;
    flex-direction: column;
  }

  .error-title {
    margin: 16px 0 18px;
  }

  /* Simulator Shell */
  .simulator-wrapper {
    margin: 28px 0 36px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .sim-terminal-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    padding: 8px 14px;
    font-family: var(--mono);
    font-size: 11px;
  }

  .sim-status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }

  .sim-blink-led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: simBlink 1.4s infinite;
  }

  @keyframes simBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  .sim-sys-name {
    letter-spacing: 0.6px;
    font-weight: 500;
  }

  .sim-tools {
    display: flex;
    gap: 8px;
  }

  .sim-ctrl-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 3px 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--foreground);
    cursor: pointer;
  }

  .sim-ctrl-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sim-display-container {
    position: relative;
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }

  #lander-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    cursor: crosshair;
    outline: none;
  }

  #lander-canvas:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .sim-banner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    padding: 20px;
    text-align: center;
  }

  .banner-success, .banner-fail {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    padding: 18px 24px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 13px;
    max-width: 480px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .banner-success strong {
    color: #1D8338;
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
  }

  html[data-theme='dark'] .banner-success strong {
    color: #5CD068;
  }

  .banner-fail strong {
    color: var(--accent);
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .banner-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
  }

  .sim-retry-btn {
    display: inline-block;
