---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import LanderGame from '../components/LanderGame.astro';
import { url } from '../config';
---

<Base
  title="404 | Page Not Found"
  ogImagePath="og/404.png"
  ogImageAlt="Page not found"
  noindex={true}
>
  <section class="shell page-section error-section" data-pagefind-ignore>
    <div class="error-container">
      <!-- Unmistakable 404 Headline & Status -->
      <div class="error-badge-row">
        <div class="error-badge" aria-hidden="true">
          <span class="error-code">404</span>
          <span class="error-badge-divider">/</span>
          <span class="error-badge-label">PAGE NOT FOUND</span>
        </div>
        <div class="error-status-chip">
          <span class="status-dot"></span>
          <span>HTTP 404 — UNRESOLVED ROUTE</span>
        </div>
      </div>

      <h1 class="page-title error-title">
        The page you’re looking for <br />
        <span class="accent-word"><em>doesn’t exist.</em></span>
      </h1>

      <p class="page-description">
        No document or project matches <code class="missing-path-code" id="missing-path-display">the requested URL</code>. It may have been moved, renamed, or never existed in the repository.
      </p>

      <!-- Immediate primary navigation for quick departure -->
      <div class="error-quick-nav">
        <a class="button primary" href={url()}>
          Return to Flight Deck <ArrowIcon />
        </a>
        <a class="button" href={url('writing/')}>
          Field Dispatches <ArrowIcon />
        </a>
        <a class="button" href={url('projects/')}>
          Engineering Monographs <ArrowIcon />
        </a>
        <a class="text-link" href={url('writing/tags/')}>
          Browse by Topic →
        </a>
      </div>

      <!-- Apollo AGC / Trajectory Correction Mini-Simulator -->
      <LanderGame />

      <!-- Telemetry Diagnostics Box -->
      <div class="error-telemetry-box">
        <div class="telemetry-row">
          <span>VECTOR STATUS:</span>
          <span class="telemetry-warn">UNRESOLVED ROUTE (HTTP 404)</span>
        </div>
        <div class="telemetry-row">
          <span>NAVIGATION AID:</span>
          <span>IF YOU WERE FOLLOWING A LINK, IT MAY BE DEPRECATED OR MISSPELLED</span>
        </div>
        <div class="telemetry-row">
          <span>RECOMMENDED WAYPOINTS:</span>
          <span>FLIGHT DECK, FIELD DISPATCHES, OR TOPIC INDEX</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Populate attempted path for maximum clarity
  (function () {
    const pathDisplay = document.getElementById('missing-path-display');
    if (pathDisplay) {
      try {
        const p = window.location.pathname;
        if (p && p.length > 0 && p !== '/') {
          pathDisplay.textContent = p;
        } else {
          pathDisplay.textContent = 'this URL';
        }
      } catch {
        pathDisplay.textContent = 'this URL';
      }
    }
  })();
</script>

<style>
  .error-section {
    padding: 48px 0 80px;
    max-width: 760px;
  }

  .error-container {
    display: flex;
    flex-direction: column;
  }

  /* 404 Headline & Badges */
  .error-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 4px 12px;
    border-radius: 4px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
  }

  .error-code {
    font-size: 14px;
    color: var(--accent);
  }

  .error-badge-divider {
    opacity: 0.5;
  }

  .error-badge-label {
    font-size: 11px;
    letter-spacing: 1px;
  }

  .error-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.5px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .error-title {
    margin: 12px 0 16px;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.15;
  }

  .page-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 24px;
    max-width: 640px;
  }

  .missing-path-code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 3px;
    color: var(--foreground);
    word-break: break-all;
  }

  .error-quick-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px dashed var(--border);
  }

  /* Telemetry Meta Box */
  .error-telemetry-box {
    margin: 18px 0 28px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
  }

  .telemetry-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    gap: 12px;
  }

  .telemetry-warn {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .telemetry-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }
</style>
