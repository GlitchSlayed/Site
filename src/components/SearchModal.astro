---
import SearchIcon from './SearchIcon.astro';
import { url } from '../config';

const basePath = url();
---

<div id="search-overlay" class="search-overlay" aria-hidden="true">
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Search site">
    <div class="search-header">
      <SearchIcon />
      <input
        type="search"
        id="search-input"
        placeholder="Search writing, projects & notes…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search input"
      />
      <kbd class="search-kbd" id="search-close-kbd">Esc</kbd>
    </div>
    <div id="search-results" class="search-results" role="region" aria-live="polite" aria-label="Search results">
      <div class="search-initial">Type to start searching…</div>
    </div>
    <div class="search-footer">
      <span class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
      <span class="search-hint"><kbd>↵</kbd> Open</span>
      <span class="search-hint"><kbd>Esc</kbd> Close</span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: min(15vh, 120px) 16px 24px;
    animation: fadeIn 0.15s ease-out;
  }

  html[data-theme='light'] .search-overlay {
    background: rgba(240, 240, 240, 0.7);
  }

  .search-overlay.open {
    display: flex;
  }

  .search-dialog {
    width: 100%;
    max-width: 620px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 96, 59, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideDown 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html[data-theme='light'] .search-dialog {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideDown {
    from { transform: translateY(-8px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .search-header svg {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .search-header input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--foreground);
    font-size: 15px;
    font-family: var(--sans);
    outline: none;
    line-height: 1.4;
  }

  .search-header input::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }

  .search-kbd {
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--background);
    border: 1px solid var(--border);
    color: var(--muted);
    cursor: pointer;
  }

  .search-kbd:hover {
    color: var(--foreground);
    border-color: var(--muted);
  }

  .search-results {
    max-height: min(440px, 60vh);
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .search-initial,
  .search-empty,
  .search-loading {
    padding: 28px 20px;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
    font-family: var(--mono);
  }

  :global(.search-result-item) {
    display: block;
    padding: 12px 14px;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: background 0.12s, border-color 0.12s;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.active) {
    background: var(--hover);
    border-color: var(--border);
  }

  :global(.search-result-item.active .search-result-title) {
    color: var(--accent);
  }

  :global(.search-result-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  :global(.search-result-title) {
    font-size: 14.5px;
    font-weight: 550;
    letter-spacing: -0.2px;
    color: var(--foreground);
    margin: 0;
  }

  :global(.search-result-badge) {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.6px;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  :global(.search-result-excerpt) {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-result-excerpt mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }

  .search-footer {
    border-top: 1px solid var(--border);
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 10px;
    font-family: var(--mono);
    color: var(--muted);
    background: var(--surface);
  }

  .search-hint {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .search-hint kbd {
    font-family: var(--mono);
    font-size: 9px;
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--background);
    border: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .search-overlay {
      padding-top: 12px;
    }
    .search-footer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay,
    .search-dialog {
      animation: none !important;
    }
  }
</style>

<script define:vars={{ basePath }}>
  let pagefind = null;
  let pagefindLoaded = false;
  let activeIndex = -1;
  let debounceTimeout = null;
  let currentQuery = '';

  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const closeKbd = document.getElementById('search-close-kbd');

  async function loadPagefind() {
    if (pagefindLoaded) return pagefind;
    try {
      const pfPath = `${basePath.replace(/\/$/, '')}/pagefind/pagefind.js`;
      pagefind = await import(/* @vite-ignore */ pfPath);
      await pagefind.options({
        baseUrl: basePath,
      });
      pagefindLoaded = true;
      return pagefind;
    } catch (e) {
      console.warn('Pagefind index not found or loading failed. It is generated during `astro build`.', e);
      return null;
    }
  }

  function openSearch() {
    if (!overlay) return;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    loadPagefind();
    setTimeout(() => {
      input?.focus();
      input?.select();
    }, 20);
  }

  function closeSearch() {
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (input) input.value = '';
    currentQuery = '';
    activeIndex = -1;
    if (resultsContainer) {
      resultsContainer.innerHTML = '<div class="search-initial">Type to start searching…</div>';
    }
  }

  function updateActiveItem(items) {
    items.forEach((item, index) => {
      if (index === activeIndex) {
        item.classList.add('active');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('active');
      }
    });
  }

  async function performSearch(query) {
    currentQuery = query;
    if (!query) {
      activeIndex = -1;
      resultsContainer.innerHTML = '<div class="search-initial">Type to start searching…</div>';
      return;
    }

    const pf = await loadPagefind();
    if (!pf) {
      resultsContainer.innerHTML = '<div class="search-empty">Search index will be built when building the site (<code>npm run build</code>).</div>';
      return;
    }

    resultsContainer.innerHTML = '<div class="search-loading">Searching…</div>';

    try {
      const searchResponse = await pf.search(query);
      if (currentQuery !== query) return; // Stale query check

      if (!searchResponse || searchResponse.results.length === 0) {
        activeIndex = -1;
        resultsContainer.innerHTML = `<div class="search-empty">No results found for "<strong>${escapeHtml(query)}</strong>"</div>`;
        return;
      }

      // Fetch top 10 results
      const topResults = await Promise.all(
        searchResponse.results.slice(0, 10).map((r) => r.data())
      );
      if (currentQuery !== query) return;

      activeIndex = 0;
      resultsContainer.innerHTML = topResults
        .map((data, index) => {
          const isProject = data.url.includes('/projects/');
          const isWriting = data.url.includes('/writing/');
          const badge = isProject ? 'Project' : isWriting ? 'Writing' : 'Page';
          const title = data.meta?.title || 'Untitled';
          const excerpt = data.excerpt || '';

          return `
            <a href="${data.url}" class="search-result-item ${index === 0 ? 'active' : ''}" data-index="${index}">
              <div class="search-result-header">
                <h4 class="search-result-title">${escapeHtml(title)}</h4>
                <span class="search-result-badge">${badge}</span>
              </div>
              <p class="search-result-excerpt">${excerpt}</p>
            </a>
          `;
        })
        .join('');

      // Add click handling for results
      resultsContainer.querySelectorAll('.search-result-item').forEach((item) => {
        item.addEventListener('mouseenter', () => {
          const idx = parseInt(item.getAttribute('data-index') || '0', 10);
          activeIndex = idx;
          const items = resultsContainer.querySelectorAll('.search-result-item');
          updateActiveItem(items);
        });
      });
    } catch (err) {
      console.error('Search error:', err);
      resultsContainer.innerHTML = '<div class="search-empty">Search error encountered.</div>';
    }
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Global triggers
  window.addEventListener('open-search', openSearch);
  window.addEventListener('close-search', closeSearch);

  // Keyboard navigation & shortcuts
  window.addEventListener('keydown', (e) => {
    // ⌘K or Ctrl+K toggle
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (overlay?.classList.contains('open')) {
        closeSearch();
      } else {
        openSearch();
      }
      return;
    }

    if (!overlay?.classList.contains('open')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
      return;
    }

    const items = resultsContainer?.querySelectorAll('.search-result-item');
    if (!items || items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = (activeIndex + 1) % items.length;
      updateActiveItem(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = (activeIndex - 1 + items.length) % items.length;
      updateActiveItem(items);
    } else if (e.key === 'Enter') {
      if (activeIndex >= 0 && items[activeIndex]) {
        e.preventDefault();
        items[activeIndex].click();
      }
    }
  });

  // Overlay click to close
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) {
      closeSearch();
    }
  });

  closeKbd?.addEventListener('click', closeSearch);

  // Input debouncing
  input?.addEventListener('input', (e) => {
    const val = e.target.value.trim();
    clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(() => {
      performSearch(val);
    }, 150);
  });
</script>
