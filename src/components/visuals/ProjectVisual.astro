---
import TechnicalPlate from '../drawings/TechnicalPlate.astro';
import './visuals.css';
export type VisualKind = 'dither' | 'grain' | 'mesh' | 'grid' | 'dots' | 'asset' | 'screenshot';
interface Props {variant?:VisualKind;title?:string;label?:string;accent?:string;image?:string;imageAlt?:string;animate?:boolean;}
const {variant='asset',title='',label='',image,imageAlt=''}=Astro.props;
const imageURL=image?(/^https?:\/\//i.test(image)?image:`${import.meta.env.BASE_URL}${image.replace(/^\/+/, '')}`):undefined;
---
{!imageURL ? <TechnicalPlate kind="code" /> : <div class:list={['pv', `pv-${variant}`]}>
 {variant==='screenshot'?<div class="pv-window"><div class="pv-window-bar"><span aria-hidden="true">○ ○ ○</span><span>{label||'Project screenshot'}</span></div><img src={imageURL} alt={imageAlt} width="1200" height="750" loading="lazy" decoding="async" /></div>:<><img class="pv-asset" src={imageURL} alt={imageAlt} width="1200" height="640" loading="lazy" decoding="async" />{(title||label)&&<div class="pv-copy">{label&&<span class="pv-label">{label}</span>}{title&&<span class="pv-title">{title}</span>}</div>}</>}
</div>}
