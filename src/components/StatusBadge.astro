---
export interface Props {
  status: 'Concept' | 'In Development' | 'Prototype' | 'Completed' | string;
  size?: 'normal' | 'compact';
  class?: string;
}

const { status, size = 'normal', class: className = '' } = Astro.props;

// Normalize status key for CSS class, e.g. "in-development"
const statusKey = (status || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const statusDescriptions: Record<string, string> = {
  concept: 'Initial theoretical modeling, governing equations & feasibility analysis',
  'in-development': 'Active aerodynamic simulation, parameter exploration & code refinement',
  prototype: 'Computational or hardware prototype undergoing validation against benchmarks',
  completed: 'Peer-reviewed, validated study with published results & interactive explorer',
};
---

<span
  class:list={['status-badge', `status-${statusKey}`, `size-${size}`, className]}
  data-tooltip={`Project Status: ${status}`}
  data-tooltip-subtitle={statusDescriptions[statusKey] || 'Project lifecycle phase'}
  data-tooltip-pos="top"
>
  <span class="status-indicator" aria-hidden="true"></span>
  <span class="status-label">{status}</span>
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 2px;
    font-family: var(--mono);
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 0.6px;
    white-space: nowrap;
    border: 1px solid var(--border);
    line-height: 1;
    transition: border-color 0.16s ease, background-color 0.16s ease;
    flex-shrink: 0;
  }

  .status-indicator {
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* Size variants */
  .size-normal {
    padding: 3px 8px;
    font-size: 9.5px;
    gap: 6px;
  }

  .size-normal .status-indicator {
    width: 5px;
    height: 5px;
  }

  .size-compact {
    padding: 2px 6px;
    font-size: 8.5px;
    gap: 5px;
  }

  .size-compact .status-indicator {
    width: 4px;
    height: 4px;
  }

  /* Status Colors: Clean Editorial Palette (No Glowing Shadows) */

  /* 1. CONCEPT (Slate / Theoretical Monograph) */
  .status-concept {
    color: #4f46e5;
    background: rgba(79, 70, 229, 0.05);
    border-color: rgba(79, 70, 229, 0.22);
  }
  .status-concept .status-indicator {
    background: #4f46e5;
  }

  /* 2. IN DEVELOPMENT (Rust / Active Engineering) */
  .status-in-development {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-border);
  }
  .status-in-development .status-indicator {
    background: var(--accent);
  }

  /* 3. PROTOTYPE (Technical Cyan / Experimental) */
  .status-prototype {
    color: #0e7490;
    background: rgba(14, 116, 144, 0.05);
    border-color: rgba(14, 116, 144, 0.24);
  }
  .status-prototype .status-indicator {
    background: #0e7490;
  }

  /* 4. COMPLETED (Forest Sage / Verified Benchmark) */
  .status-completed {
    color: #15803d;
    background: rgba(21, 128, 61, 0.05);
    border-color: rgba(21, 128, 61, 0.22);
  }
  .status-completed .status-indicator {
    background: #15803d;
  }

  /* Dark Theme Adjustments */
  :global(html[data-theme='dark']) .status-concept {
    color: #a5b4fc;
    background: rgba(165, 180, 252, 0.08);
    border-color: rgba(165, 180, 252, 0.25);
  }
  :global(html[data-theme='dark']) .status-concept .status-indicator {
    background: #a5b4fc;
  }

  :global(html[data-theme='dark']) .status-in-development {
    color: #f87171;
    background: rgba(248, 113, 113, 0.08);
    border-color: rgba(248, 113, 113, 0.28);
  }
  :global(html[data-theme='dark']) .status-in-development .status-indicator {
    background: #f87171;
  }

  :global(html[data-theme='dark']) .status-prototype {
    color: #67e8f9;
    background: rgba(103, 232, 249, 0.08);
    border-color: rgba(103, 232, 249, 0.25);
  }
  :global(html[data-theme='dark']) .status-prototype .status-indicator {
    background: #67e8f9;
  }

  :global(html[data-theme='dark']) .status-completed {
    color: #86efac;
    background: rgba(134, 239, 172, 0.08);
    border-color: rgba(134, 239, 172, 0.25);
  }
  :global(html[data-theme='dark']) .status-completed .status-indicator {
    background: #86efac;
  }
</style>
