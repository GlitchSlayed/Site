---
export interface Props {
  status: 'Concept' | 'In Development' | 'Prototype' | 'Completed' | string;
  size?: 'normal' | 'compact';
  class?: string;
}

const { status, size = 'normal', class: className = '' } = Astro.props;

// Normalize status key for CSS class, e.g. "in-development"
const statusKey = (status || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const statusDescriptions: Record<string, string> = {
  concept: 'Initial theoretical modeling, governing equations & feasibility analysis',
  'in-development': 'Active aerodynamic simulation, parameter exploration & code refinement',
  prototype: 'Computational or hardware prototype undergoing validation against benchmarks',
  completed: 'Peer-reviewed, validated study with published results & interactive explorer',
};
---

<span
  class:list={['status-badge', `status-${statusKey}`, `size-${size}`, className]}
  data-tooltip={`Project Status: ${status}`}
  data-tooltip-subtitle={statusDescriptions[statusKey] || 'Project lifecycle phase'}
  data-tooltip-pos="top"
  tabindex="0"
>
  <span class="status-indicator" aria-hidden="true"></span>
  <span class="status-label">{status}</span>
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    font-family: var(--mono);
    text-transform: uppercase;
    font-weight: 550;
    letter-spacing: 0.85px;
    white-space: nowrap;
    border: 1px solid var(--border);
    line-height: 1;
    transition: border-color 0.18s ease, background-color 0.18s ease;
    flex-shrink: 0;
  }

  .status-indicator {
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Size variants */
  .size-normal {
    padding: 5px 11px;
    font-size: 9.5px;
    gap: 7px;
  }

  .size-normal .status-indicator {
    width: 6px;
    height: 6px;
  }

  .size-compact {
    padding: 3px 8px;
    font-size: 8px;
    gap: 5px;
  }

  .size-compact .status-indicator {
    width: 5px;
    height: 5px;
  }

  /* Status Colors */

  /* 1. CONCEPT (Exploratory Blueprint Lavender/Purple) */
  .status-concept {
    color: #c4b5fd;
    background: rgba(167, 139, 250, 0.08);
    border-color: rgba(167, 139, 250, 0.32);
  }
  .status-concept .status-indicator {
    background: #a78bfa;
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.7);
  }

  /* 2. IN DEVELOPMENT (Active Rocket Flare Orange) */
  .status-in-development {
    color: #ff8366;
    background: rgba(255, 96, 59, 0.1);
    border-color: rgba(255, 96, 59, 0.38);
  }
  .status-in-development .status-indicator {
    background: var(--accent);
    box-shadow: 0 0 9px rgba(255, 96, 59, 0.8);
  }

  /* 3. PROTOTYPE (Electric Sky Blue) */
  .status-prototype {
    color: #7dd3fc;
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.35);
  }
  .status-prototype .status-indicator {
    background: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.7);
  }

  /* 4. COMPLETED (Telemetry Emerald Green) */
  .status-completed {
    color: #86efac;
    background: rgba(74, 222, 128, 0.08);
    border-color: rgba(74, 222, 128, 0.35);
  }
  .status-completed .status-indicator {
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.7);
  }

  /* Light Theme Adjustments */
  :global(html[data-theme='light']) .status-concept {
    color: #6d28d9;
    background: rgba(109, 40, 217, 0.06);
    border-color: rgba(109, 40, 217, 0.28);
  }
  :global(html[data-theme='light']) .status-concept .status-indicator {
    background: #7c3aed;
    box-shadow: 0 0 6px rgba(124, 58, 237, 0.4);
  }

  :global(html[data-theme='light']) .status-in-development {
    color: #c63c18;
    background: rgba(198, 60, 24, 0.07);
    border-color: rgba(198, 60, 24, 0.3);
  }
  :global(html[data-theme='light']) .status-in-development .status-indicator {
    background: #c63c18;
    box-shadow: 0 0 6px rgba(198, 60, 24, 0.4);
  }

  :global(html[data-theme='light']) .status-prototype {
    color: #0369a1;
    background: rgba(3, 105, 161, 0.06);
    border-color: rgba(3, 105, 161, 0.28);
  }
  :global(html[data-theme='light']) .status-prototype .status-indicator {
    background: #0284c7;
    box-shadow: 0 0 6px rgba(2, 132, 199, 0.4);
  }

  :global(html[data-theme='light']) .status-completed {
    color: #15803d;
    background: rgba(21, 128, 61, 0.06);
    border-color: rgba(21, 128, 61, 0.28);
  }
  :global(html[data-theme='light']) .status-completed .status-indicator {
    background: #16a34a;
    box-shadow: 0 0 6px rgba(22, 163, 74, 0.4);
  }
</style>
