---
import { randomUUID } from 'node:crypto';
import { drawingInfo, drawingSvg, type DrawingKind } from '../../lib/drawings';
interface Props { kind?: DrawingKind; hero?: boolean; caption?: boolean; }
const {kind='wing',hero=false,caption=true}=Astro.props;
const info=drawingInfo[kind];
---
<figure class:list={['technical-plate',{'technical-plate-hero':hero}]}>
 <div class="technical-plate-field" data-technical-surface={hero || undefined} data-motion={hero?'true':'false'}>
  {hero && <canvas class="technical-surface" aria-hidden="true"></canvas>}
  <Fragment set:html={drawingSvg(kind,randomUUID())} />
 </div>
 {caption&&<figcaption><span>{info.label}</span><span>{info.caption}</span></figcaption>}
</figure>
<script>
import { initTechnicalSurfaces } from '../../lib/technicalSurface';
initTechnicalSurfaces();
</script>
