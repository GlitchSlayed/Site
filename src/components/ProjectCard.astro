---
import Art from './Art.astro';
import ArrowIcon from './ArrowIcon.astro';
import {url} from '../config';
const {project}=Astro.props;
---
<a class="project-card" href={url(`projects/${project.id}/`)}><Art kind={project.data.art}/><div class="card-body"><div class="post-meta"><span>{project.data.tags[0]}</span><span>{project.data.status}</span></div><h3>{project.data.title}<span class="card-arrow"><ArrowIcon/></span></h3><p>{project.data.description}</p><div class="tag-list">{project.data.tags.slice(1).map((tag:string)=><span>{tag}</span>)}</div></div></a>
