---
import Art from './Art.astro';
import ProjectVisual from './visuals/ProjectVisual.astro';
import ArrowIcon from './ArrowIcon.astro';
import StatusBadge from './StatusBadge.astro';
import SparkIcon from './SparkIcon.astro';
import { url, dateLabel } from '../config';

export interface Props {
  project: any;
  featured?: boolean;
}

const { project, featured = project.data.featured } = Astro.props;
---

<a class:list={['project-card', { featured }]} href={url(`projects/${project.id}/`)}>
  {project.data.visual ? (
    <ProjectVisual
      variant={project.data.visual}
      title={project.data.visual === 'screenshot' ? '' : project.data.title}
      label={project.data.visualLabel || project.data.tags[0]}
      accent={project.data.visualAccent || '#ff603b'}
      image={project.data.visualImage}
      imageAlt={project.data.visualImageAlt || ''}
      animate={project.data.visualAnimate}
    />
  ) : (
    <Art kind={project.data.art} />
  )}
  <div class="card-body">
    <div class="post-meta">
      {featured && (
        <span class="featured-badge" data-tooltip="Featured Project" data-tooltip-pos="top">
          <SparkIcon />
          <span>Featured</span>
        </span>
      )}
      {project.data.category && <span class="project-category">{project.data.category}</span>}
      <span class="project-date">{dateLabel(project.data.date)}</span>
      <StatusBadge status={project.data.status} size="compact" />
    </div>
    <h3>{project.data.title}<span class="card-arrow"><ArrowIcon /></span></h3>
    <p>{project.data.description}</p>
    <div class="tag-list">{project.data.tags.map((tag: string) => <span>{tag}</span>)}</div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }

  /* Editorial Accent Border for Featured Projects */
  .project-card.featured {
    border-color: var(--accent-border);
    position: relative;
  }

  .project-card.featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    z-index: 2;
  }

  .project-card.featured:hover {
    border-color: var(--accent);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
  }

  .card-body p {
    flex: 1;
  }

  /* Featured Identifier Badge (Crisp Monospace Label) */
  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    font-size: 8.5px;
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: 2px;
    line-height: 1;
    flex-shrink: 0;
  }

  .featured-badge :global(.spark-icon) {
    width: 9px;
    height: 9px;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .featured-badge {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
