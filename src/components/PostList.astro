---
import type { CollectionEntry } from 'astro:content';
import { url, dateLabel } from '../config';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {
    posts.map((post) => (
      <a class="post-row" href={url(`writing/${post.id}/`)}>
        <div>
          <div class="post-meta">
            <span>{post.data.tags[0]}</span>
            <span>{dateLabel(post.data.date)}</span>
            {post.data.sample && <span class="sample-label">Sample</span>}
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
        <span class="row-arrow"><ArrowIcon /></span>
      </a>
    ))
  }
</div>

