---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import SparkIcon from '../components/SparkIcon.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { url, dateLabel } from '../config';
import '../styles/newspaper.css';

interface Props {
  entry: any;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { data } = entry;
const h2Headings = headings.filter((h) => h.depth === 2);
const category = data.tags && data.tags.length > 0 ? data.tags[0] : 'Engineering';

// Server-side derived reading time and content metadata
const rawBody = entry.body || '';
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readTimeMin = Math.max(1, Math.round(wordCount / 220));
const readTimeLabel = `${readTimeMin} min read`;
const hasLeadVisual = /<img|!\[/.test(rawBody);
---

<Base
  title={`${data.title} | The Technical Dispatch`}
  description={data.description}
  ogType="article"
  ogImagePath={`og/writing/${entry.id}.png`}
  ogImageAlt={data.title}
>
  <div class="newspaper-workspace mode-spread" id="newspaper-container" data-has-visual={hasLeadVisual ? 'true' : 'false'}>
    <!-- Subtle Editorial Reading Control Strip -->
    <nav class="editorial-nav-strip" aria-label="Dispatch reading navigation">
      <div class="nav-strip-left">
        <a class="nav-back-link" href={url('writing/')} title="Return to writing index">
          <span class="back-arrow-icon" aria-hidden="true">←</span>
          <span>Dispatches</span>
        </a>
        <span class="nav-strip-divider" aria-hidden="true">/</span>
        <span class="nav-category-tag">{category}</span>
      </div>

      <div class="nav-strip-center">
        <!-- Table of Contents Dropdown -->
        {h2Headings.length > 0 && (
          <div class="editorial-toc-wrap">
            <button
              type="button"
              class="nav-toc-trigger"
              id="btn-toc-toggle"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span>Contents ▾</span>
            </button>
            <div class="editorial-toc-sheet" id="newspaper-toc-menu" role="menu">
              <div class="toc-sheet-header">
                <span class="toc-sheet-label">Article Outline</span>
                <span class="toc-sheet-readtime">{readTimeLabel}</span>
              </div>
              <ol class="toc-sheet-list">
                {h2Headings.map((h, i) => (
                  <li>
                    <a class="newspaper-toc-item" href={`#${h.slug}`} data-slug={h.slug} role="menuitem">
                      <span class="toc-item-num">{String(i + 1).padStart(2, '0')}.</span>
                      <span class="toc-item-text">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        )}
        <span class="nav-read-time" id="nav-read-time">{readTimeLabel}</span>
      </div>

      <div class="nav-strip-right">
        <!-- Reading Mode Switcher -->
        <div class="nav-mode-switcher" role="radiogroup" aria-label="Reading layout mode">
          <button
            type="button"
            class="mode-switch-btn active"
            id="btn-mode-spread"
            aria-checked="true"
            title="Two-page facing spread mode"
          >
            <span>Facing Pages</span>
          </button>
          <span class="mode-switch-sep">·</span>
          <button
            type="button"
            class="mode-switch-btn"
            id="btn-mode-continuous"
            aria-checked="false"
            title="Single-column continuous scroll mode"
          >
            <span>Continuous</span>
          </button>
        </div>

        <div class="nav-strip-divider" aria-hidden="true"></div>

        <!-- Typography Size Controls -->
        <div class="nav-type-controls" aria-label="Type size">
          <button
            type="button"
            class="type-btn"
            id="btn-font-smaller"
            aria-label="Decrease font size"
            title="Decrease font size"
          >
            A−
          </button>
          <button
            type="button"
            class="type-btn"
            id="btn-font-larger"
            aria-label="Increase font size"
            title="Increase font size"
          >
            A+
          </button>
        </div>
      </div>

      <!-- Integrated Hairline Progress Indicator -->
      <div class="reading-progress-track" aria-hidden="true">
        <div class="reading-progress-bar" id="reading-progress-bar"></div>
      </div>
    </nav>

    <!-- Broad-sheet Cover Header (Crowning Spread 0 & Top of Continuous View) -->
    <header class="newspaper-cover-banner" id="cover-banner">
      <!-- Top Masthead Header -->
      <div class="masthead-flag">
        <div class="flag-meta-left">
          <span class="flag-origin">INDEPENDENT ENGINEERING NOTEBOOK</span>
          <span class="flag-rule-dot">·</span>
          <span class="flag-field">FIELD NOTES // {category.toUpperCase()}</span>
        </div>
        <div class="flag-title-wrap">
          <div class="masthead-nameplate">THE TECHNICAL DISPATCH</div>
          <div class="masthead-tagline">Investigations into Aerospace Systems, Physical Fabrication &amp; Open Software</div>
        </div>
        <div class="flag-meta-right">
          <span class="flag-date">{dateLabel(data.date).toUpperCase()}</span>
          <span class="flag-rule-dot">·</span>
          <span class="flag-author">VANSH DATTA</span>
        </div>
      </div>

      <!-- Classic Broadsheet Oxford Rule (Thick over Thin) -->
      <div class="oxford-rule" aria-hidden="true"></div>

      <!-- Article Title & Lede Block -->
      <div class="cover-article-header">
        <div class="cover-meta-kicker">
          <span class="kicker-category">{category}</span>
          <span class="kicker-sep">—</span>
          <span class="kicker-readtime">{readTimeLabel}</span>
        </div>

        <h1 class="cover-headline">{data.title}</h1>

        {data.description && (
          <p class="cover-deck">{data.description}</p>
        )}

        <div class="cover-byline-bar">
          <span class="byline-item">By <strong>Vansh Datta</strong></span>
          <span class="byline-sep">/</span>
          <span class="byline-item">Published on {dateLabel(data.date)}</span>
          <span class="byline-sep">/</span>
          <span class="byline-item">Editorial Dispatch</span>
        </div>
      </div>

      <div class="cover-bottom-rule" aria-hidden="true"></div>
    </header>

    <!-- Desktop Open Newspaper: Two Facing Pages -->
    <div class="newspaper-spread spread-with-cover" id="newspaper-spread-view" aria-label="Facing newspaper pages">
      <!-- Left Page (Verso) -->
      <article class="newspaper-page newspaper-page-left" id="page-container-left">
        <header class="page-running-head">
          <span class="running-brand">THE TECHNICAL DISPATCH</span>
          <span class="running-title">FIELD NOTE // {category.toUpperCase()}</span>
        </header>

        <div class="page-content-area" id="left-page-body">
          <!-- Dynamically populated page content -->
        </div>

        <footer class="page-folio">
          <span class="page-folio-meta">VANSH DATTA</span>
          <span class="page-folio-num" id="left-page-num">— 1 —</span>
        </footer>
      </article>

      <!-- Right Page (Recto) -->
      <article class="newspaper-page newspaper-page-right" id="page-container-right">
        <header class="page-running-head">
          <span class="running-title">“{data.title}”</span>
          <span class="running-brand">{dateLabel(data.date).toUpperCase()}</span>
        </header>

        <div class="page-content-area" id="right-page-body">
          <!-- Dynamically populated page content -->
        </div>

        <footer class="page-folio">
          <span class="page-folio-meta">{category.toUpperCase()}</span>
          <span class="page-folio-num" id="right-page-num">— 2 —</span>
        </footer>
      </article>
    </div>

    <!-- Dedicated Bottom Page Navigation & Tracker -->
    <nav class="editorial-bottom-nav" id="newspaper-bottom-nav" aria-label="Page navigation">
      <button
        type="button"
        class="bottom-nav-btn prev-btn"
        id="btn-bottom-prev"
        aria-label="Previous spread"
        title="Previous spread (Left arrow)"
      >
        <span aria-hidden="true">←</span>
        <span>Previous Spread</span>
      </button>

      <div class="bottom-nav-center">
        <span class="bottom-page-label" id="bottom-page-display">Spread 1 of 2 · Pages 1–2 of 4</span>
        <div class="bottom-spread-dots" id="bottom-page-dots" aria-label="Spread pagination dots"></div>
        <span class="bottom-nav-hint">Press ← or → arrow keys to turn pages</span>
      </div>

      <button
        type="button"
        class="bottom-nav-btn next-btn"
        id="btn-bottom-next"
        aria-label="Next spread"
        title="Next spread (Right arrow)"
      >
        <span>Next Spread</span>
        <span aria-hidden="true">→</span>
      </button>
    </nav>

    <!-- Continuous Reading View (Unified Single-Column Mode) -->
    <article class="newspaper-continuous" id="newspaper-continuous-view">
      <div class="continuous-body-wrap">
        <!-- Article Body with Drop Cap -->
        <div class="newspaper-article-body drop-cap-lead" id="continuous-body" data-pagefind-body>
          <slot />
        </div>
      </div>
    </article>

    <!-- Source Container (Hidden when paginated; preserved for SEO & indexing) -->
    <div id="newspaper-source-data" style="display: none;" aria-hidden="true">
      <slot />
    </div>

    <!-- Article Discussion Section -->
    <div class="newspaper-footer-section">
      <Comments />
      <div class="article-end">
        <SparkIcon />
        <span>End of dispatch. Keep asking better questions.</span>
        <a href={url('writing/')}>More Dispatches <ArrowIcon /></a>
      </div>
    </div>
  </div>
</Base>

<script is:inline>
(function() {
  const container = document.getElementById('newspaper-container');
  const sourceData = document.getElementById('newspaper-source-data');
  const coverBanner = document.getElementById('cover-banner');
  const spreadView = document.getElementById('newspaper-spread-view');
  const leftPageBody = document.getElementById('left-page-body');
  const rightPageBody = document.getElementById('right-page-body');
  const leftPageNum = document.getElementById('left-page-num');
  const rightPageNum = document.getElementById('right-page-num');
  const bottomDisplay = document.getElementById('bottom-page-display');
  const bottomDots = document.getElementById('bottom-page-dots');
  const btnBottomPrev = document.getElementById('btn-bottom-prev');
  const btnBottomNext = document.getElementById('btn-bottom-next');
  const progressBar = document.getElementById('reading-progress-bar');
  const btnModeSpread = document.getElementById('btn-mode-spread');
  const btnModeContinuous = document.getElementById('btn-mode-continuous');
  const btnToc = document.getElementById('btn-toc-toggle');
  const tocMenu = document.getElementById('newspaper-toc-menu');
  const btnFontSmaller = document.getElementById('btn-font-smaller');
  const btnFontLarger = document.getElementById('btn-font-larger');

  if (!container || !sourceData || !leftPageBody || !rightPageBody) return;

  // Reading mode state: 'spread' or 'continuous'
  let currentMode = window.innerWidth >= 1100 ? 'spread' : 'continuous';
  container.className = `newspaper-workspace mode-${currentMode}`;
  updateModeButtons();

  // Font scale state
  let fontScale = 16;

  // Pagination data
  let pages = [];
  let currentSpread = 0;

  function updateModeButtons() {
    if (btnModeSpread && btnModeContinuous) {
      btnModeSpread.classList.toggle('active', currentMode === 'spread');
      btnModeSpread.setAttribute('aria-checked', String(currentMode === 'spread'));
      btnModeContinuous.classList.toggle('active', currentMode === 'continuous');
      btnModeContinuous.setAttribute('aria-checked', String(currentMode === 'continuous'));
    }
  }

  // Accurate DOM measurement probe
  function measureElement(el, probe) {
    const clone = el.cloneNode(true);
    probe.appendChild(clone);
    const rect = clone.getBoundingClientRect();
    const style = window.getComputedStyle(clone);
    const marginTop = parseFloat(style.marginTop) || 0;
    const marginBottom = parseFloat(style.marginBottom) || 0;
    const hasImg = clone.tagName === 'IMG' || clone.querySelector('img');
    const measuredHeight = hasImg ? Math.max(240, rect.height) : rect.height;
    const total = measuredHeight + marginTop + marginBottom;
    probe.removeChild(clone);
    return Math.max(20, total);
  }

  // Segment source elements into virtual pages
  function paginateContent() {
    pages = [];
    let rawElements = Array.from(sourceData.children);
    if (rawElements.length === 0) return;

    // Filter out redundant leading H1 that duplicates article headline
    if (rawElements.length > 0 && rawElements[0].tagName.toLowerCase() === 'h1') {
      rawElements = rawElements.slice(1);
    }

    // Create an invisible measurement probe styled identical to page content
    const colWidth = leftPageBody.clientWidth > 100
      ? leftPageBody.clientWidth
      : Math.max(480, Math.min(660, Math.floor((container.clientWidth - 120) / 2)));

    const probe = document.createElement('div');
    probe.className = 'newspaper-article-body';
    probe.style.cssText =
      'position:absolute;left:-9999px;top:0;width:' +
      colWidth +
      'px;visibility:hidden;pointer-events:none;font-family:var(--serif);font-size:var(--newspaper-font-size);line-height:var(--newspaper-line-height);';
    document.body.appendChild(probe);

    // Height budgets:
    // Cover Spread (Spread 0): Pages 0 & 1 sit under the cover banner, so budget is ~600px.
    // Interior Spreads (Spread 1+): Pages 2+ have full page height without cover banner, so budget is ~760px.
    const spread0Budget = 600;
    const interiorBudget = 760;

    let currentPageNodes = [];
    let currentHeight = 0;
    let pageIndex = 0;
    let budget = spread0Budget;

    for (let i = 0; i < rawElements.length; i++) {
      const el = rawElements[i];
      const tag = el.tagName.toLowerCase();
      const h = measureElement(el, probe);
      const isHeading = /^h[1-4]$/i.test(tag);

      // Rule: Keep heading with next paragraph
      let totalNeeded = h;
      if (isHeading && i + 1 < rawElements.length) {
        totalNeeded += measureElement(rawElements[i + 1], probe);
      }

      // Allow soft overflow (up to 8%) for text elements to prevent awkward premature breaks
      const softBudget = isHeading ? budget : budget * 1.08;

      if (currentHeight + totalNeeded > softBudget && currentPageNodes.length > 0) {
        // Attempt clean split for multi-item lists (ul / ol)
        if ((tag === 'ul' || tag === 'ol') && el.children.length > 1 && currentHeight < budget * 0.8) {
          const items = Array.from(el.children);
          const firstList = document.createElement(tag);
          const secondList = document.createElement(tag);
          const initialStart = tag === 'ol' ? (parseInt(el.getAttribute('start') || '1', 10) || 1) : 1;
          if (tag === 'ol') firstList.setAttribute('start', String(initialStart));

          let splitIdx = 0;
          let listAccumHeight = 0;
          for (let j = 0; j < items.length; j++) {
            const itemH = measureElement(items[j], probe);
            if (currentHeight + listAccumHeight + itemH <= budget) {
              firstList.appendChild(items[j].cloneNode(true));
              listAccumHeight += itemH;
              splitIdx = j + 1;
            } else {
              break;
            }
          }

          if (splitIdx > 0 && splitIdx < items.length) {
            currentPageNodes.push(firstList);
            pages.push(currentPageNodes);
            pageIndex++;
            currentPageNodes = [];
            currentHeight = 0;
            budget = pageIndex < 2 ? spread0Budget : interiorBudget;

            for (let j = splitIdx; j < items.length; j++) {
              secondList.appendChild(items[j].cloneNode(true));
            }
            if (tag === 'ol') secondList.setAttribute('start', String(initialStart + splitIdx));
            currentPageNodes.push(secondList);
            currentHeight = measureElement(secondList, probe);
            continue;
          }
        }

        // Finalize current page and advance
        pages.push(currentPageNodes);
        pageIndex++;
        currentPageNodes = [];
        currentHeight = 0;
        budget = pageIndex < 2 ? spread0Budget : interiorBudget;
      }

      currentPageNodes.push(el.cloneNode(true));
      currentHeight += h;
    }

    if (currentPageNodes.length > 0) {
      pages.push(currentPageNodes);
    }

    // Clean up probe
    document.body.removeChild(probe);
  }

  // Render a specific spread (left page = 2*index, right page = 2*index + 1)
  function renderSpread(index) {
    currentSpread = index;
    const leftIdx = index * 2;
    const rightIdx = index * 2 + 1;
    const totalPages = pages.length;
    const totalSpreads = Math.ceil(totalPages / 2);

    // Opening Spread Distinction:
    // If on Spread 0, show the grand cover banner above the spread.
    // If on Interior Spreads (Spread 1+), hide the cover banner and enable full running heads.
    if (coverBanner && spreadView) {
      if (index === 0 && currentMode === 'spread') {
        coverBanner.style.display = 'block';
        spreadView.classList.add('spread-with-cover');
        spreadView.classList.remove('spread-interior');
      } else if (currentMode === 'spread') {
        coverBanner.style.display = 'none';
        spreadView.classList.remove('spread-with-cover');
        spreadView.classList.add('spread-interior');
      }
    }

    // Populate Left Page (Verso)
    leftPageBody.innerHTML = '';
    const leftContent = document.createElement('div');
    leftContent.className = 'newspaper-article-body';
    if (leftIdx === 0) leftContent.classList.add('drop-cap-lead');

    if (pages[leftIdx]) {
      pages[leftIdx].forEach((node) => leftContent.appendChild(node.cloneNode(true)));
    }
    leftPageBody.appendChild(leftContent);
    leftPageNum.textContent = `— ${leftIdx + 1} —`;

    // Populate Right Page (Recto)
    rightPageBody.innerHTML = '';
    const rightContent = document.createElement('div');
    rightContent.className = 'newspaper-article-body';

    if (rightIdx < totalPages && pages[rightIdx]) {
      pages[rightIdx].forEach((node) => rightContent.appendChild(node.cloneNode(true)));
      rightPageNum.textContent = `— ${rightIdx + 1} —`;

      // End ornament if dispatch completes on this page
      if (rightIdx === totalPages - 1) {
        const endOrnament = document.createElement('div');
        endOrnament.className = 'article-end-ornament';
        endOrnament.innerHTML = '<span>✦ ✦ ✦</span><small>END OF DISPATCH</small>';
        rightContent.appendChild(endOrnament);
      }
    } else {
      // Dignified editorial colophon for final odd spread
      const colophon = document.createElement('div');
      colophon.className = 'article-end-colophon';
      colophon.innerHTML = `
        <div class="colophon-inner">
          <div class="colophon-mark">✦</div>
          <div class="colophon-title">THE TECHNICAL DISPATCH</div>
          <div class="colophon-sub">DISPATCH COMPLETED · VANSH DATTA</div>
          <div class="colophon-rule"></div>
          <div class="colophon-desc">A personal engineering record documenting aerospace design, manufacturing tooling, and open-source software projects.</div>
        </div>
      `;
      rightContent.appendChild(colophon);
      rightPageNum.textContent = '— END —';
    }
    rightPageBody.appendChild(rightContent);

    // Update Bottom Navigation & Tracker
    const displayEnd = Math.min(rightIdx + 1, totalPages);
    if (bottomDisplay) {
      bottomDisplay.textContent = `Spread ${index + 1} of ${totalSpreads} · Pages ${leftIdx + 1}–${displayEnd} of ${totalPages}`;
    }

    // Render clickable spread dots in bottom nav
    if (bottomDots) {
      bottomDots.innerHTML = '';
      for (let s = 0; s < totalSpreads; s++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `spread-dot ${s === index ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Go to spread ${s + 1}`);
        dot.addEventListener('click', () => {
          renderSpread(s);
          window.scrollTo({ top: container.offsetTop - 70, behavior: 'smooth' });
        });
        bottomDots.appendChild(dot);
      }
    }

    if (btnBottomPrev) btnBottomPrev.disabled = index === 0;
    if (btnBottomNext) btnBottomNext.disabled = index >= totalSpreads - 1;

    // Update Progress Bar
    const pct = Math.round(((index + 1) / totalSpreads) * 100);
    if (progressBar) progressBar.style.width = `${pct}%`;
  }

  // Initialize pagination
  paginateContent();
  if (currentMode === 'spread') {
    renderSpread(0);
  }

  // Bottom Navigation Handlers
  btnBottomPrev?.addEventListener('click', () => {
    if (currentSpread > 0) {
      renderSpread(currentSpread - 1);
      window.scrollTo({ top: container.offsetTop - 70, behavior: 'smooth' });
    }
  });

  btnBottomNext?.addEventListener('click', () => {
    const totalSpreads = Math.ceil(pages.length / 2);
    if (currentSpread < totalSpreads - 1) {
      renderSpread(currentSpread + 1);
      window.scrollTo({ top: container.offsetTop - 70, behavior: 'smooth' });
    }
  });

  // Mode Switchers
  btnModeSpread?.addEventListener('click', () => {
    if (currentMode !== 'spread') {
      currentMode = 'spread';
      container.className = 'newspaper-workspace mode-spread';
      updateModeButtons();
      renderSpread(currentSpread);
    }
  });

  btnModeContinuous?.addEventListener('click', () => {
    if (currentMode !== 'continuous') {
      currentMode = 'continuous';
      container.className = 'newspaper-workspace mode-continuous';
      updateModeButtons();
      if (coverBanner) coverBanner.style.display = 'block';
    }
  });

  // Font Size Adjusters
  btnFontSmaller?.addEventListener('click', () => {
    if (fontScale > 14) {
      fontScale -= 1;
      document.documentElement.style.setProperty('--newspaper-font-size', `${fontScale}px`);
      paginateContent();
      renderSpread(Math.min(currentSpread, Math.ceil(pages.length / 2) - 1));
    }
  });

  btnFontLarger?.addEventListener('click', () => {
    if (fontScale < 20) {
      fontScale += 1;
      document.documentElement.style.setProperty('--newspaper-font-size', `${fontScale}px`);
      paginateContent();
      renderSpread(Math.min(currentSpread, Math.ceil(pages.length / 2) - 1));
    }
  });

  // Table of Contents Toggle
  btnToc?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = tocMenu?.classList.toggle('open');
    btnToc.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.editorial-toc-wrap')) {
      tocMenu?.classList.remove('open');
      btnToc?.setAttribute('aria-expanded', 'false');
    }
  });

  // Jump to Heading in Spread Mode
  document.querySelectorAll('.newspaper-toc-item').forEach((item) => {
    item.addEventListener('click', (e) => {
      const slug = item.dataset.slug;
      if (!slug) return;
      tocMenu?.classList.remove('open');
      btnToc?.setAttribute('aria-expanded', 'false');

      if (currentMode === 'spread') {
        e.preventDefault();
        // Locate which page contains this heading
        let targetPage = 0;
        for (let p = 0; p < pages.length; p++) {
          const hasHeading = pages[p].some((node) => {
            return node.id === slug || (node.querySelector && node.querySelector(`#${slug}`));
          });
          if (hasHeading) {
            targetPage = p;
            break;
          }
        }
        renderSpread(Math.floor(targetPage / 2));
        window.scrollTo({ top: container.offsetTop - 70, behavior: 'smooth' });
      }
    });
  });

  // Keyboard Navigation: Left & Right arrows
  window.addEventListener('keydown', (e) => {
    const active = document.activeElement ? document.activeElement.tagName : '';
    if (active === 'INPUT' || active === 'TEXTAREA') return;

    if (currentMode === 'spread') {
      if (e.key === 'ArrowLeft' && currentSpread > 0) {
        btnBottomPrev?.click();
      } else if (e.key === 'ArrowRight' && currentSpread < Math.ceil(pages.length / 2) - 1) {
        btnBottomNext?.click();
      }
    }
  });

  // Responsive Resizing Check
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      if (window.innerWidth < 1100 && currentMode === 'spread') {
        currentMode = 'continuous';
        container.className = 'newspaper-workspace mode-continuous';
        updateModeButtons();
        if (coverBanner) coverBanner.style.display = 'block';
      }
    }, 150);
  });
})();
</script>
