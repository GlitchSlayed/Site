---
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import SourceShelf from '../components/SourceShelf.astro';
import { url, dateLabel } from '../config';
import { readingMinutes } from '../lib/editorial';
interface Props {entry:any;headings?:MarkdownHeading[];}
const {entry,headings=[]}=Astro.props;
const {data}=entry;
const related=(await getCollection('writing',({data:d})=>!d.draft&&!d.sample)).filter(p=>p.id!==entry.id).map(p=>({p,score:p.data.tags.filter((t:string)=>data.tags.includes(t)).length})).sort((a,b)=>b.score-a.score||+b.p.data.date-+a.p.data.date).slice(0,2);
---
<Base title={`${data.title} | Vansh’s Notebook`} description={data.description} ogType="article" ogImagePath={`og/writing/${entry.id}.png`} ogImageAlt={data.title}>
<div class="reader reader-shell" id="reader" data-mode="continuous">
<nav class="reader-toolbar" aria-label="Reading controls"><a href={url('writing/')}>← The Notebook</a><div class="reader-enhancements" hidden><div class="reader-modes" role="group" aria-label="Page layout"><button type="button" data-mode="spread" aria-pressed="false">Facing pages</button><button type="button" data-mode="continuous" aria-pressed="true">Scroll</button></div><button type="button" id="type-down" aria-label="Smaller article text">A−</button><button type="button" id="type-up" aria-label="Larger article text">A+</button><button type="button" id="print-story">Print</button></div></nav>
<header class="journal-masthead reader-masthead"><div class="journal-edition"><span>Vansh Datta / {data.tags[0]||'Notes'}</span><time datetime={data.date.toISOString()}>{dateLabel(data.date)}</time></div><a href={url('writing/')} class="journal-name">The Notebook</a><p>A personal publication about aerospace, making things, and computing.</p></header>
<header class="story-header"><p class="small-label">{data.tags.join(' / ')}{data.sample?' / Sample article':''}</p><h1>{data.title}</h1><p class="story-deck">{data.description}</p><div class="story-byline"><a href={url('about/')}>By Vansh Datta</a><span>{readingMinutes(entry.body)} min read</span><time datetime={data.date.toISOString()}>{dateLabel(data.date)}</time></div></header>
{headings.some(h=>h.depth===2)&&<details class="reader-contents"><summary>Inside this article</summary><nav aria-label="Article sections">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}
<article id="story-body" class="story-body prose" data-pagefind-body><slot /></article>
<nav class="reader-pagination" aria-label="Article pages" hidden><button type="button" id="reader-prev">← Previous</button><span id="reader-position" role="status"></span><button type="button" id="reader-next">Next →</button></nav>
<SourceShelf body={entry.body} />
<section class="story-colophon"><p class="small-label">Written by Vansh Datta</p><p>I’m a mechanical engineering student at Hofstra, concentrating in aerospace. This notebook is where I work through projects, software, and the questions behind them.</p><div class="inline-links"><a href={url('about/')} class="text-link">More about me →</a><a href={url('rss.xml')} class="text-link">Follow new writing ↗</a><button type="button" class="text-link" id="copy-story" hidden>Copy article link</button><span id="copy-status" role="status"></span></div></section>
{related.length>0&&<section class="related-stories"><p class="small-label">Keep reading</p><div class="story-grid">{related.map(({p})=><article><span class="small-label">{p.data.tags[0]}</span><h2><a href={url(`writing/${p.id}/`)}>{p.data.title}</a></h2><p>{p.data.description}</p></article>)}</div></section>}
<div class="story-discussion"><Comments /></div>
</div>
</Base>
<script>
import { initReader } from '../lib/reader';
initReader();
</script>
