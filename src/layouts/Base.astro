---
import '../styles/global.css';
import '../styles/engineering.css';
import '../styles/personal.css';
import '../styles/technical.css';
import '../styles/mdx.css';
import 'katex/dist/katex.min.css';
import 'uplot/dist/uPlot.min.css';
import Rocket from '../components/Rocket.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import SearchIcon from '../components/SearchIcon.astro';
import SearchModal from '../components/SearchModal.astro';
import { Font } from 'astro:assets';
import { site, url } from '../config';
import { getCommitHash } from '../lib/git';

const {
  title = site.title,
  description = site.description,
  ogType = 'website',
  ogImagePath = 'og/home.png',
  ogImageAlt = title,
} = Astro.props;
const pathname = Astro.url.pathname;
const siteBase = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site) : undefined;
const basePath = siteBase?.pathname || '/';
const routePath = pathname.startsWith(basePath) ? pathname.slice(basePath.length) : pathname.replace(/^\/+/, '');
const canonical = siteBase ? new URL(routePath, siteBase) : undefined;
const socialImage = siteBase ? new URL(url(ogImagePath), Astro.site) : undefined;
const configured = canonical?.hostname !== 'example.com';
const commitHash = getCommitHash();
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8F7F3" id="meta-theme-color" />
    <title>{title}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--serif-display" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--sans" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--mono" />
    {configured && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Vansh's Technical Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {configured && <meta property="og:url" content={canonical} />}
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:secure_url" content={socialImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogImageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImage} />
          <meta name="twitter:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s writing`} href={url('rss.xml')} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        // Light mode is the default for first-time visitors; respect explicit saved preference.
        const preferred = saved === 'dark' || saved === 'light' ? saved : 'light';
        document.documentElement.dataset.theme = preferred;
        const metaTheme = document.getElementById('meta-theme-color');
        if (metaTheme) {
          metaTheme.setAttribute('content', preferred === 'dark' ? '#141413' : '#F8F7F3');
        }
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head><body><a class="skip" href="#main">Skip to content</a>
<header class="header" data-pagefind-ignore>
  <div class="shell header-inner">
    <a class="brand" href={url()} aria-label="Vansh's Technical Blog home">
      <span class="brand-icon"><Rocket /></span>
      <span class="brand-text">
        <span class="brand-name">Vansh Datta</span>
        <span class="brand-label">A PERSONAL NOTEBOOK</span>
      </span>
    </a>
    <nav aria-label="Main navigation">
      {
        [
          ['writing/', 'Writing'],
          ['projects/', 'Projects'],
          ['about/', 'About'],
        ].map(([href, label]) => (
          <a href={url(href)} aria-current={pathname.startsWith(url(href)) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <button class="theme-button" id="search-trigger" aria-label="Search site" data-tooltip="Search site" data-tooltip-shortcut="⌘K">
        <SearchIcon />
      </button>
      <button class="theme-button" id="theme-toggle" aria-label="Switch to dark theme" data-tooltip="Switch to dark theme" data-tooltip-shortcut="Shift+T">
        <svg class="moon-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
<main id="main"><slot /></main>
<footer class="shell footer" data-pagefind-ignore>
  <div class="footer-colophon">
    <a class="footer-brand" href={url()}>
      <Rocket />
      <span>
        <strong>Vansh Datta</strong>
        <small>Aerospace, engineering &amp; software projects.</small>
      </span>
    </a>
  </div>
  <div class="footer-links">
    <button type="button" id="texture-toggle" class="texture-toggle" aria-pressed="true" hidden>Texture on</button>
    <a href={url('rss.xml')}>RSS <ArrowIcon /></a>
    {site.github && <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowIcon /></a>}
    {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <ArrowIcon /></a>}
    {site.email && <a href={`mailto:${site.email}`}>Email <ArrowIcon /></a>}
    {
      commitHash && (
        <a
          class="footer-commit"
          href={`https://github.com/GlitchSlayed/Site/commit/${commitHash}`}
          target="_blank"
          rel="noopener noreferrer"
          data-tooltip="View commit on GitHub"
          data-tooltip-subtitle={`Commit SHA: ${commitHash}`}
          aria-label={`View commit ${commitHash} on GitHub`}
        >
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
            <path d="M10.5 7.75a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Zm1.43.75a4.002 4.002 0 0 0-7.86 0H.75a.75.75 0 1 0 0 1.5h3.32a4.002 4.002 0 0 0 7.86 0h3.32a.75.75 0 1 0 0-1.5h-3.32Z" />
          </svg>
          <code>{commitHash}</code>
        </a>
      )
    }
    <span class="footer-copyright">© {new Date().getFullYear()} Vansh Datta</span>
  </div>
</footer>
<SearchModal />
<script>
import { initTooltips } from '../lib/tooltip';
initTooltips();

const searchTrigger = document.querySelector<HTMLButtonElement>('#search-trigger');
searchTrigger?.addEventListener('click', (e) => {
  window.dispatchEvent(new CustomEvent('open-search', { detail: { target: e.currentTarget } }));
});

const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
function syncLabel() {
  const isDark = document.documentElement.dataset.theme === 'dark';
  button?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
  button?.setAttribute('data-tooltip', isDark ? 'Switch to light theme' : 'Switch to dark theme');
  const metaTheme = document.getElementById('meta-theme-color');
  if (metaTheme) {
    metaTheme.setAttribute('content', isDark ? '#141413' : '#F8F7F3');
  }
  if (button) {
    button.innerHTML = isDark
      ? `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"/></svg>`
      : `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;
  }
}
syncLabel();
button?.addEventListener('click', () => {
  const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  document.documentElement.dataset.theme = theme;
  try {
    localStorage.setItem('theme', theme);
  } catch {}
  syncLabel();
  window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme } }));

});

window.addEventListener('keydown', (e) => {
  if (e.shiftKey && (e.key === 't' || e.key === 'T')) {
    const activeTag = document.activeElement?.tagName;
    if (activeTag !== 'INPUT' && activeTag !== 'TEXTAREA' && !e.ctrlKey && !e.metaKey && !e.altKey) {
      button?.click();
    }
  }
});
</script>
</body></html>
