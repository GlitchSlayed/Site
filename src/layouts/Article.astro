---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import BackArrow from '../components/BackArrow.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import SparkIcon from '../components/SparkIcon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { url, dateLabel } from '../config';
import Comments from '../components/Comments.astro';
import EngineeringBrief from '../components/EngineeringBrief.astro';
import TechnicalPlate from '../components/drawings/TechnicalPlate.astro';
import SourceShelf from '../components/SourceShelf.astro';
import { getCollection } from 'astro:content';
import { statusNotes, readingMinutes } from '../lib/editorial';

interface Props {
  entry: any;
  headings?: MarkdownHeading[];
  type?: 'writing' | 'projects';
}

const { entry, headings = [], type = 'projects' } = Astro.props;
const { data } = entry;
const h2Headings = headings.filter((h) => h.depth === 2);
const related = (await getCollection('writing', ({data:d}) => !d.draft && !d.sample)).filter(p => p.data.tags.some((t:string) => data.tags.includes(t))).sort((a,b) => +b.data.date-+a.data.date).slice(0,2);
---

<Base
  title={`${data.title} | Project notes`}
  description={data.description}
  ogType="article"
  ogImagePath={`og/${type}/${entry.id}.png`}
  ogImageAlt={data.title}
>
  <div class="shell article-shell">
    <div class="monograph-nav-bar">
      <a class="back-link" href={url(`${type}/`)}>
        <BackArrow /> Back to {type === 'writing' ? 'Field Notes' : 'Projects'}
      </a>
      <div class="doc-code">
        DOC // {entry.id.toUpperCase()}
      </div>
    </div>

    <!-- Engineering Report Document Header -->
    <header class="monograph-header">
      <div class="monograph-doc-banner">
        <div class="banner-left">
          <span class="classification-badge">PROJECT NOTEBOOK</span>
          <span class="report-num">REF: {entry.id.replace(/-/g, '_').toUpperCase()}</span>
        </div>
        <div class="banner-right">
          <span class="monograph-date">{dateLabel(data.date)}</span>
          {data.status && <StatusBadge status={data.status} size="compact" />}
        </div>
      </div>

      <h1 class="monograph-title">{data.title}</h1>

      <!-- Framed Scientific Abstract Box -->
      <div class="monograph-abstract-box">
        <div class="abstract-label">
          <span>The question & scope</span>
        </div>
        <p class="abstract-text">{data.description}</p>
        <div class="abstract-keywords">
          <span class="keywords-label">Topics:</span>
          {data.tags.map((tag: string) => <span class="keyword-tag">{tag}</span>)}
        </div>
      </div>

      <!-- Technical Metadata Spec Grid -->
      <div class="monograph-meta-grid">
        <div class="meta-cell">
          <span class="meta-label">AUTHOR</span>
          <span class="meta-val">Vansh Datta</span>
        </div>
        <div class="meta-cell">
          <span class="meta-label">AFFILIATION</span>
          <span class="meta-val">Hofstra Mechanical &amp; Aerospace</span>
        </div>
        <div class="meta-cell">
          <span class="meta-label">DISCIPLINE</span>
          <span class="meta-val">{data.category || data.tags[0] || 'Project'}</span>
        </div>
        <div class="meta-cell">
          <span class="meta-label">STATUS</span>
          <span class="meta-val">{data.status || 'Active Iteration'}</span>
        </div>
      </div>

      {
        data.sample && (
          <div class="notice">
            <strong>Editorial Note:</strong> Sample research monograph included with this publication. Demonstrates interactive engineering calculations and layout.
          </div>
        )
      }
    </header>

    {data.engineering && <EngineeringBrief brief={data.engineering} />}
    {data.drawing && <details class="project-drawing-detail"><summary>Open the project drawing <span>Illustrative schematic</span></summary><TechnicalPlate kind={data.drawing} /></details>}
    <aside class="project-state-context"><strong>{data.status}</strong><p>{statusNotes[data.status] || 'See the notes below for the current scope.'}</p><span class="small-label">{readingMinutes(entry.body)} min read · Published {dateLabel(data.date)}</span></aside>
    {h2Headings.length > 0 && <details class="project-mobile-contents"><summary>In this project</summary><nav>{h2Headings.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}
    <div class="article-grid">
      <article class="prose monograph-prose" data-pagefind-body>
        <slot />
      </article>

      {
        h2Headings.length > 0 && (
          <aside class="toc monograph-toc">
            <div class="eyebrow">CONTENTS // ON THIS PAGE</div>
            <nav class="toc-nav" aria-label="Project sections">
              <span class="toc-indicator" aria-hidden="true" />
              {h2Headings.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          </aside>
        )
      }
    </div>

    {related.length > 0 && <section class="related-stories"><p class="small-label">Related notes from the blog</p><div class="story-grid">{related.map(p => <article><h2><a href={url(`writing/${p.id}/`)}>{p.data.title}</a></h2><p>{p.data.description}</p></article>)}</div></section>}
    <SourceShelf body={entry.body} />
    <!-- Discussion and Comments -->
    <div class="monograph-comments-container">
      <Comments />
    </div>

    <!-- Monograph Sign-Off End Plate -->
    <div class="monograph-end-plate">
      <div class="end-plate-icon">
        <SparkIcon />
      </div>
      <div class="end-plate-text">
        <span class="end-plate-status">END OF THIS WRITE-UP</span>
        <p>The work continues at the stage shown above. Thanks for taking a look.</p>
      </div>
      <a class="button" href={url(`${type}/`)}>
        All {type === 'writing' ? 'Field Notes' : 'Investigations'} <ArrowIcon />
      </a>
    </div>
  </div>
</Base>

<style>
  .monograph-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .doc-code {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
  }

  .monograph-header {
    margin-bottom: 40px;
  }

  .monograph-doc-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    margin-bottom: 20px;
    font-family: var(--mono);
    font-size: 9.5px;
  }

  .banner-left {
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: 0.8px;
  }

  .classification-badge {
    color: var(--accent);
    font-weight: 600;
  }

  .report-num {
    color: var(--muted);
  }

  .banner-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .monograph-date {
    color: var(--subtle);
  }

  .monograph-title {
    font-family: var(--serif-display);
    font-size: clamp(30px, 4.2vw, 46px);
    font-weight: 550;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: var(--foreground);
    margin: 0 0 24px;
  }

  /* Framed Abstract */
  .monograph-abstract-box {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-left: 3px solid var(--accent);
    padding: 24px;
    border-radius: 3px;
    margin-bottom: 24px;
  }

  .abstract-label {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 1px;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .abstract-text {
    font-family: var(--serif);
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--foreground);
    margin: 0 0 16px;
    font-style: italic;
  }

  .abstract-keywords {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
  }

  .keywords-label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.8px;
    color: var(--subtle);
  }

  .keyword-tag {
    font-family: var(--mono);
    font-size: 9px;
    padding: 2px 7px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--muted);
  }

  /* Technical Metadata Spec Grid */
  .monograph-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding: 14px 18px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    margin-bottom: 28px;
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .meta-label {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.8px;
    color: var(--subtle);
  }

  .meta-val {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--foreground);
  }

  .monograph-comments-container {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  /* End Plate */
  .monograph-end-plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding: 24px 28px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    flex-wrap: wrap;
  }

  .end-plate-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
  }

  .end-plate-text {
    flex: 1;
    min-width: 260px;
  }

  .end-plate-status {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 1px;
    color: var(--accent);
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }

  .end-plate-text p {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .monograph-meta-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .monograph-doc-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('.toc-nav');
  const article = document.querySelector<HTMLElement>('.prose');

  if (toc && article) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const indicator = toc.querySelector<HTMLElement>('.toc-indicator');
    const headings = links
      .map((link) => article.querySelector<HTMLElement>(`#${CSS.escape(decodeURIComponent(link.hash.slice(1)))}`))
      .filter((heading): heading is HTMLElement => heading !== null);
    let activeIndex = -1;
    let frame = 0;

    const setActive = (index: number) => {
      if (index === activeIndex || !links[index] || !indicator) return;
      activeIndex = index;
      links.forEach((link, linkIndex) => {
        if (linkIndex === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const link = links[index];
      indicator.style.transform = `translateY(${link.offsetTop}px)`;
      indicator.style.height = `${link.offsetHeight}px`;
    };

    const syncActiveSection = () => {
      frame = 0;
      const activationLine = Math.min(window.innerHeight * 0.28, 220);
      let current = 0;
      headings.forEach((heading, index) => {
        if (heading.getBoundingClientRect().top <= activationLine) current = index;
      });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = headings.length - 1;
      }
      setActive(current);
    };

    const requestSync = () => {
      if (!frame) frame = requestAnimationFrame(syncActiveSection);
    };

    window.addEventListener('scroll', requestSync, { passive: true });
    window.addEventListener('resize', requestSync);
    window.addEventListener('hashchange', requestSync);
    requestSync();
  }
</script>
