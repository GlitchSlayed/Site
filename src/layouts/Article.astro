---
import Base from './Base.astro';
import {url,dateLabel} from '../config';
const {entry,headings=[],type='writing'}=Astro.props;
const {data}=entry;
---
<Base title={`${data.title} — Vansh`} description={data.description}><div class="shell article-shell"><a class="back-link" href={url(`${type}/`)}>← Back to {type}</a><header class="article-header"><div class="post-meta"><span>{data.tags.join(' / ')}</span><span>{dateLabel(data.date)}</span>{data.status&&<span>{data.status}</span>}</div><h1>{data.title}</h1><p>{data.description}</p>{data.sample&&<div class="notice">Sample article included with this site. Illustrative content, not a report of completed work.</div>}</header><div class="article-grid"><article class="prose"><slot/></article>{headings.length>0&&<aside class="toc"><div class="eyebrow">ON THIS PAGE</div><nav aria-label="Article contents">{headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div><div class="article-end"><span class="accent">✳</span> Keep asking better questions.<a href={url(`${type}/`)}>More {type} →</a></div></div></Base>
